---
import '../css/app.css';

export interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
}

const {
  title = 'Carat to Ratti & Ratti to Carat Converter | Free Vedic Gemstone Calculator',
  description = 'Convert Carats to Ratti and Ratti to Carats instantly with certified 0.91 Pakka Ratti ratio. Accurate Vedic astrological calculator with multi-unit breakdown (mg, grams, grains, cents), Sawa Ratti decoder, and body weight dosage.',
  canonicalUrl = 'https://rattitocarat.com',
} = Astro.props;

const currentPath = Astro.url.pathname;

// 1. WebSite Schema with hasPart for Google Sitelinks & Subsections
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Ratti to Carat',
  alternateName: [
    'Ratti to Carat Converter',
    'Carat to Ratti Calculator',
    'Vedic Gemstone Calculator',
    'Pakka Ratti to Carat Tool'
  ],
  url: 'https://rattitocarat.com',
  description: 'Precision gemstone weight calculation engine and Vedic astrological Sawa decoder calibrated to certified 0.9100 Pakka Ratti and 200 mg metric standards.',
  inLanguage: ['en', 'hi'],
  hasPart: [
    {
      '@type': 'WebApplication',
      name: 'Carat to Ratti Calculator',
      description: 'Convert metric Carats to Ratti instantly using certified 0.91 Pakka and 0.90 Sunee gemstone ratios.',
      url: 'https://rattitocarat.com/carat-to-ratti',
      applicationCategory: 'UtilityApplication',
      operatingSystem: 'All'
    },
    {
      '@type': 'WebApplication',
      name: 'Ratti to Carat Calculator',
      description: 'Convert traditional Ratti to metric Carats with exact milligram, gram, and cent precision for jewelry trade.',
      url: 'https://rattitocarat.com/ratti-to-carat',
      applicationCategory: 'UtilityApplication',
      operatingSystem: 'All'
    },
    {
      '@type': 'WebApplication',
      name: 'Vedic Body-Weight Gemstone Dosage Calculator',
      description: 'Calculate personal Vedic gemstone weight based on body weight using the classical 1 Ratti per 10–12 kg rule.',
      url: 'https://rattitocarat.com/body-weight-calculator',
      applicationCategory: 'HealthApplication',
      operatingSystem: 'All'
    },
    {
      '@type': 'WebPage',
      name: 'Sawa Ratti Astrological Scale Chart',
      description: 'Complete sacred astrological weight reference chart from 1.25 to 12.25 Ratti with ruling planets and Navratna gems.',
      url: 'https://rattitocarat.com/sawa-ratti-chart'
    },
    {
      '@type': 'FAQPage',
      name: 'Gemstone FAQs & Knowledge Base',
      description: 'Comprehensive Q&A answering all mathematical, gemological, and astrological weight questions.',
      url: 'https://rattitocarat.com/faqs'
    },
    {
      '@type': 'Blog',
      name: 'Gemological Blog & Astrological Guides',
      description: 'In-depth educational articles on gemstone buying, certified testing, and Vedic astrological prescriptions.',
      url: 'https://rattitocarat.com/blog'
    }
  ]
};

// 2. SiteNavigationElement Schema (Explicitly for Google Front Position Sitelinks)
const siteNavigationSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Primary Site Navigation',
  itemListElement: [
    {
      '@type': 'SiteNavigationElement',
      position: 1,
      name: 'Body Weight Dosage Calculator',
      description: 'Calculate gemstone weight based on body mass (1 Ratti per 10-12 kg rule)',
      url: 'https://rattitocarat.com/body-weight-calculator'
    },
    {
      '@type': 'SiteNavigationElement',
      position: 2,
      name: 'Sawa Ratti Astrological Scale',
      description: 'Auspicious Sawa weight chart covering 1.25 to 12.25 Ratti with ruling planets',
      url: 'https://rattitocarat.com/sawa-ratti-chart'
    },
    {
      '@type': 'SiteNavigationElement',
      position: 3,
      name: 'Carat to Ratti Calculator',
      description: 'Instant conversion of Carats to Pakka and Sunee Ratti',
      url: 'https://rattitocarat.com/carat-to-ratti'
    },
    {
      '@type': 'SiteNavigationElement',
      position: 4,
      name: 'Ratti to Carat Calculator',
      description: 'Instant conversion of Ratti to Carats and Milligrams',
      url: 'https://rattitocarat.com/ratti-to-carat'
    },
    {
      '@type': 'SiteNavigationElement',
      position: 5,
      name: 'Gemstone FAQs & Knowledge Base',
      description: 'Comprehensive answers on formulas, Pakka vs Sunee, and pricing',
      url: 'https://rattitocarat.com/faqs'
    },
    {
      '@type': 'SiteNavigationElement',
      position: 6,
      name: 'Gemological Blog',
      description: 'Expert articles on gemstone certification and Vedic Jyotish',
      url: 'https://rattitocarat.com/blog'
    }
  ]
};

// 3. Organization Schema
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Ratti to Carat',
  url: 'https://rattitocarat.com',
  logo: 'https://rattitocarat.com/favicon.svg',
  description: 'Independent gemological conversion authority and Vedic astrological calculator.',
  sameAs: []
};

// 4. Dynamic Breadcrumb Schema based on current route
const pathClean = currentPath.replace(/\/$/, '');
const breadcrumbItems: any[] = [
  {
    '@type': 'ListItem',
    position: 1,
    name: 'Home',
    item: 'https://rattitocarat.com'
  }
];

if (pathClean === '/body-weight-calculator') {
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: 2,
    name: 'Body Weight Dosage Tool',
    item: 'https://rattitocarat.com/body-weight-calculator'
  });
} else if (pathClean === '/sawa-ratti-chart') {
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: 2,
    name: 'Sawa Ratti Astrological Scale',
    item: 'https://rattitocarat.com/sawa-ratti-chart'
  });
} else if (pathClean === '/carat-to-ratti') {
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: 2,
    name: 'Carat to Ratti Calculator',
    item: 'https://rattitocarat.com/carat-to-ratti'
  });
} else if (pathClean === '/ratti-to-carat') {
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: 2,
    name: 'Ratti to Carat Calculator',
    item: 'https://rattitocarat.com/ratti-to-carat'
  });
} else if (pathClean === '/faqs') {
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: 2,
    name: 'FAQs & Knowledge Base',
    item: 'https://rattitocarat.com/faqs'
  });
} else if (pathClean === '/blog') {
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: 2,
    name: 'Blog & Guides',
    item: 'https://rattitocarat.com/blog'
  });
} else if (pathClean === '/about') {
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: 2,
    name: 'Why We Built This',
    item: 'https://rattitocarat.com/about'
  });
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems
};

// 5. WebApplication Schema
const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Carat to Ratti & Ratti to Carat Converter',
  url: canonicalUrl,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'All',
  browserRequirements: 'Requires JavaScript. Requires HTML5.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD'
  },
  featureList: [
    'Instant Carat to Ratti Conversion (0.91 Pakka standard & 0.90 Sunee trade)',
    'Instant Ratti to Carat Conversion',
    'Real-time Multi-Unit breakdown: Milligrams, Grams, Grains, and Cents',
    'Vedic Astrological Sawa Ratti Decoder (Sawa Paanch, Sawa Saat, etc.)',
    'Vedic Body-Weight Gemstone Dosage Calculator (kg / 10 to 12 rule)',
    '1-Click WhatsApp Share for Jewelers and Astrologers',
    'Bilingual English and Hindi Support'
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Favicons & Mobile Touch Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#d97706" />
    <meta name="apple-mobile-web-app-title" content="Ratti to Carat" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://rattitocarat.com/og-image.png" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://rattitocarat.com/og-image.png" />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&family=Outfit:wght@600;700;800&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Structured Data (JSON-LD) for Google Sitelinks, Search Subsections & Knowledge Graph -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(siteNavigationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  </head>
  <body class="selection:bg-amber-500 selection:text-black">
    <slot />

    <script>
      import { initLanguageSystem } from '../utils/i18n';
      initLanguageSystem();
    </script>
  </body>
</html>
