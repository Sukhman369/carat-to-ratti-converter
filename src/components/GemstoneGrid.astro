---
import { GEMSTONE_PRESETS } from '../utils/converter';
---

<section class="w-full max-w-4xl mx-auto px-4 sm:px-6 py-6">
  <div class="space-y-4">
    <div class="flex items-center justify-between">
      <div>
        <h3 class="text-base font-bold text-slate-900 font-display">
          Navratna Astrological Weight Presets
        </h3>
        <p class="text-xs text-slate-600">
          Click any sacred gemstone to instantly load its astrologically prescribed Sawa weight.
        </p>
      </div>
      <span class="text-xs font-mono text-amber-700 bg-amber-50 px-2.5 py-1 rounded-full border border-amber-200 hidden sm:inline-block font-semibold">
        7 Core Gems
      </span>
    </div>

    <!-- 7 Gemstone Cards Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-3">
      {GEMSTONE_PRESETS.map((gem) => (
        <button
          type="button"
          class="gemstone-card group p-3.5 rounded-2xl bg-white hover:bg-slate-50 border border-slate-200/90 text-left transition-all duration-200 hover:scale-[1.03] active:scale-95 shadow-xs hover:shadow-md flex flex-col justify-between space-y-3"
          data-ratti={gem.recommendedRatti}
          data-name={gem.name}
          title={`Load ${gem.name} standard weight (${gem.recommendedRatti} Ratti)`}
        >
          <div class="flex items-center justify-between w-full">
            <span class="text-lg">{gem.icon}</span>
            <span class="text-[10px] font-mono text-slate-500 font-semibold">{gem.rattiRange}</span>
          </div>

          <div>
            <div class="text-xs font-bold text-slate-900 group-hover:text-amber-700 transition-colors">
              {gem.name}
            </div>
            <div class="text-[11px] text-slate-500 font-medium">
              {gem.hindiName}
            </div>
          </div>

          <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-[11px] font-mono">
            <span class="text-slate-500">Rec:</span>
            <span class="font-bold text-amber-800 bg-amber-50 px-1.5 py-0.5 rounded border border-amber-200/60">
              {gem.recommendedRatti} Rt
            </span>
          </div>
        </button>
      ))}
    </div>
  </div>
</section>

<script>
  const cards = document.querySelectorAll('.gemstone-card');
  cards.forEach(card => {
    card.addEventListener('click', () => {
      const ratti = parseFloat(card.getAttribute('data-ratti') || '5.25');
      window.dispatchEvent(new CustomEvent('load-gemstone-preset', {
        detail: { ratti }
      }));
    });
  });
</script>
