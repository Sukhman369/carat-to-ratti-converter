---
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full border-b border-slate-200/80 bg-white/95 backdrop-blur-xl transition-all shadow-xs">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-amber-400 via-amber-500 to-amber-600 flex items-center justify-center shadow-md shadow-amber-500/20 group-hover:scale-105 transition-transform">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 3h12l4 6-10 12L2 9z"></path>
          <path d="M11 3 8 9l4 12 4-12-3-6"></path>
          <path d="M2 9h20"></path>
        </svg>
      </div>
      <div>
        <span class="text-base font-bold tracking-tight text-slate-900 font-display block">Ratti to Carat</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-2 text-xs font-semibold text-slate-600">
      <a
        href="/body-weight-calculator"
        class:list={[
          'px-3 py-1.5 rounded-lg transition-colors',
          currentPath === '/body-weight-calculator' ? 'text-amber-700 bg-amber-50 font-bold border border-amber-200/60' : 'hover:text-amber-600 hover:bg-slate-50'
        ]}
      >
        Body Weight
      </a>
      <a
        href="/sawa-ratti-chart"
        class:list={[
          'px-3 py-1.5 rounded-lg transition-colors',
          currentPath === '/sawa-ratti-chart' ? 'text-amber-700 bg-amber-50 font-bold border border-amber-200/60' : 'hover:text-amber-600 hover:bg-slate-50'
        ]}
      >
        Sawa Charts
      </a>
      <a
        href="/blog"
        class:list={[
          'px-3 py-1.5 rounded-lg transition-colors',
          currentPath === '/blog' ? 'text-amber-700 bg-amber-50 font-bold border border-amber-200/60' : 'hover:text-amber-600 hover:bg-slate-50'
        ]}
      >
        Blog
      </a>
      <a
        href="/faqs"
        class:list={[
          'px-3 py-1.5 rounded-lg transition-colors',
          currentPath === '/faqs' ? 'text-amber-700 bg-amber-50 font-bold border border-amber-200/60' : 'hover:text-amber-600 hover:bg-slate-50'
        ]}
      >
        FAQs
      </a>
    </nav>

    <!-- Language Switcher & Mobile Menu Trigger -->
    <div class="flex items-center gap-2.5">
      <!-- Language Switcher Toggle -->
      <button
        id="lang-toggle-btn"
        type="button"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-200 transition-all active:scale-95"
        title="Toggle English / हिन्दी"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
        <span id="current-lang-text">EN / हिन्दी</span>
      </button>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden w-9 h-9 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 flex items-center justify-center transition-all active:scale-95"
        aria-label="Open Navigation Menu"
        aria-expanded="false"
      >
        <svg id="hamburger-icon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" x2="20" y1="12" y2="12"/>
          <line x1="4" x2="20" y1="6" y2="6"/>
          <line x1="4" x2="20" y1="18" y2="18"/>
        </svg>
        <svg id="close-icon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" x2="6" y1="6" y2="18"/>
          <line x1="6" x2="18" y1="6" y2="18"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Drawer -->
  <div
    id="mobile-drawer"
    class="hidden md:hidden border-t border-slate-200 bg-white/98 backdrop-blur-2xl shadow-lg px-4 py-5 space-y-2 animate-in fade-in slide-in-from-top-2 duration-200"
  >
    <a
      href="/"
      class:list={[
        'flex items-center justify-between p-3 rounded-xl text-sm font-semibold transition-colors',
        currentPath === '/' ? 'text-amber-800 bg-amber-50 border border-amber-200' : 'text-slate-700 hover:bg-slate-50'
      ]}
    >
      <span>💎 Master Calculator</span>
      <span class="text-xs font-mono text-slate-400">Home</span>
    </a>
    <a
      href="/body-weight-calculator"
      class:list={[
        'flex items-center justify-between p-3 rounded-xl text-sm font-semibold transition-colors',
        currentPath === '/body-weight-calculator' ? 'text-amber-800 bg-amber-50 border border-amber-200' : 'text-slate-700 hover:bg-slate-50'
      ]}
    >
      <span>🧘 Body Weight Dosage Tool</span>
      <span class="text-xs font-mono text-slate-400">Vedic kg/10</span>
    </a>
    <a
      href="/sawa-ratti-chart"
      class:list={[
        'flex items-center justify-between p-3 rounded-xl text-sm font-semibold transition-colors',
        currentPath === '/sawa-ratti-chart' ? 'text-amber-800 bg-amber-50 border border-amber-200' : 'text-slate-700 hover:bg-slate-50'
      ]}
    >
      <span>📜 Sawa Ratti Astrological Scale</span>
      <span class="text-xs font-mono text-slate-400">1.25–12.25 Rt</span>
    </a>
    <a
      href="/blog"
      class:list={[
        'flex items-center justify-between p-3 rounded-xl text-sm font-semibold transition-colors',
        currentPath === '/blog' ? 'text-amber-800 bg-amber-50 border border-amber-200' : 'text-slate-700 hover:bg-slate-50'
      ]}
    >
      <span>📖 Gemological Blog & Guides</span>
      <span class="text-xs font-mono text-slate-400">Articles</span>
    </a>
    <a
      href="/faqs"
      class:list={[
        'flex items-center justify-between p-3 rounded-xl text-sm font-semibold transition-colors',
        currentPath === '/faqs' ? 'text-amber-800 bg-amber-50 border border-amber-200' : 'text-slate-700 hover:bg-slate-50'
      ]}
    >
      <span>💡 FAQs & Knowledge Base</span>
      <span class="text-xs font-mono text-slate-400">Q&A</span>
    </a>

    <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500 font-mono px-1">
      <a href="/carat-to-ratti" class="hover:text-amber-700">Carat → Ratti</a>
      <span>·</span>
      <a href="/ratti-to-carat" class="hover:text-amber-700">Ratti → Carat</a>
    </div>
  </div>
</header>

<script>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileDrawer = document.getElementById('mobile-drawer');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  mobileMenuBtn?.addEventListener('click', () => {
    const isExpanded = mobileMenuBtn.getAttribute('aria-expanded') === 'true';
    mobileMenuBtn.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');

    mobileDrawer?.classList.toggle('hidden');
    hamburgerIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });
</script>
