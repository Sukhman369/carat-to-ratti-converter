---
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full border-b border-slate-200/80 bg-white/90 backdrop-blur-xl transition-all shadow-xs">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-amber-400 via-amber-500 to-amber-600 flex items-center justify-center shadow-md shadow-amber-500/20 group-hover:scale-105 transition-transform">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 3h12l4 6-10 12L2 9z"></path>
          <path d="M11 3 8 9l4 12 4-12-3-6"></path>
          <path d="M2 9h20"></path>
        </svg>
      </div>
      <div>
        <span class="text-base font-bold tracking-tight text-slate-900 font-display block leading-tight">Ratti to Carat</span>
        <span class="text-[11px] text-slate-500 hidden sm:block">rattitocarat.com</span>
      </div>
    </a>

    <!-- Navigation Links -->
    <nav class="hidden lg:flex items-center gap-2 text-xs font-semibold text-slate-600">
      <a
        href="/"
        class:list={[
          'px-3 py-1.5 rounded-lg transition-colors',
          currentPath === '/' ? 'text-amber-700 bg-amber-50 font-bold border border-amber-200/60' : 'hover:text-amber-600 hover:bg-slate-50'
        ]}
      >
        Master Tool
      </a>
      <a
        href="/carat-to-ratti"
        class:list={[
          'px-3 py-1.5 rounded-lg transition-colors',
          currentPath === '/carat-to-ratti' ? 'text-amber-700 bg-amber-50 font-bold border border-amber-200/60' : 'hover:text-amber-600 hover:bg-slate-50'
        ]}
      >
        Carat → Ratti
      </a>
      <a
        href="/ratti-to-carat"
        class:list={[
          'px-3 py-1.5 rounded-lg transition-colors',
          currentPath === '/ratti-to-carat' ? 'text-amber-700 bg-amber-50 font-bold border border-amber-200/60' : 'hover:text-amber-600 hover:bg-slate-50'
        ]}
      >
        Ratti → Carat
      </a>
      <a
        href="/body-weight-calculator"
        class:list={[
          'px-3 py-1.5 rounded-lg transition-colors',
          currentPath === '/body-weight-calculator' ? 'text-amber-700 bg-amber-50 font-bold border border-amber-200/60' : 'hover:text-amber-600 hover:bg-slate-50'
        ]}
      >
        Body Weight
      </a>
      <a
        href="/sawa-ratti-chart"
        class:list={[
          'px-3 py-1.5 rounded-lg transition-colors',
          currentPath === '/sawa-ratti-chart' ? 'text-amber-700 bg-amber-50 font-bold border border-amber-200/60' : 'hover:text-amber-600 hover:bg-slate-50'
        ]}
      >
        Sawa Charts
      </a>
    </nav>

    <!-- Language & Standards Indicator -->
    <div class="flex items-center gap-3">
      <!-- Language Switcher Toggle -->
      <button
        id="lang-toggle-btn"
        type="button"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-200 transition-all"
        title="Toggle English / हिन्दी"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
        <span id="current-lang-text">EN / हिन्दी</span>
      </button>

      <!-- Standard Indicator Badge -->
      <div class="hidden sm:flex items-center gap-2 px-2.5 py-1 rounded-md bg-emerald-50 text-emerald-800 text-xs font-mono border border-emerald-200 font-semibold">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>
        <span>0.91 Pakka Ratio</span>
      </div>
    </div>
  </div>
</header>
