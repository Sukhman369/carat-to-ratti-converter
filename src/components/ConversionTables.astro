---
import { STATIC_CARAT_TO_RATTI, STATIC_RATTI_TO_CARAT, SAWA_RATTI_TABLE } from '../utils/converter';
---

<section id="conversion-tables-section" class="w-full max-w-4xl mx-auto px-4 sm:px-6 py-8">
  <div class="rounded-3xl atelier-card p-6 sm:p-8 space-y-6 border border-slate-200 shadow-sm">
    <!-- Header & Tab Navigation -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-slate-100">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 font-display" data-i18n="tablesTitle">
          Certified Conversion Reference Tables
        </h2>
        <p class="text-xs sm:text-sm text-slate-600" data-i18n="tablesSubtitle">
          Fast reference data for jewelers, gemologists, and astrological prescriptions.
        </p>
      </div>

      <!-- Tab Buttons -->
      <div class="flex items-center gap-1.5 p-1 rounded-xl bg-slate-100 border border-slate-200 text-xs font-semibold self-start sm:self-auto">
        <button
          type="button"
          id="tab-btn-carat-first"
          class="px-3 py-1.5 rounded-lg bg-white text-slate-900 shadow-xs font-bold transition-all"
          data-i18n="tabCaratToRatti"
        >
          Carat → Ratti
        </button>
        <button
          type="button"
          id="tab-btn-ratti-first"
          class="px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 transition-all"
          data-i18n="tabRattiToCarat"
        >
          Ratti → Carat
        </button>
        <button
          type="button"
          id="tab-btn-sawa-scale"
          class="px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 transition-all"
          data-i18n="tabSawaScale"
        >
          Sawa Scale
        </button>
      </div>
    </div>

    <!-- Table Search Filter -->
    <div class="flex items-center gap-3 p-3 rounded-2xl bg-slate-50 border border-slate-200">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="text"
        id="table-search-input"
        placeholder="Filter table rows (e.g. 5.25, 7.00, Pukhraj)..."
        data-i18n-placeholder="searchPlaceholder"
        class="w-full bg-transparent text-xs text-slate-900 placeholder:text-slate-400 focus:outline-none font-mono"
      />
    </div>

    <!-- Tab 1: Carat to Ratti Table -->
    <div id="tab-content-carat-first" class="overflow-x-auto rounded-2xl border border-slate-200">
      <table class="w-full text-left text-xs font-mono border-collapse table-auto">
        <thead class="bg-slate-50 text-slate-500 border-b border-slate-200 font-semibold uppercase text-[11px] tracking-wider">
          <tr>
            <th class="p-3.5 text-slate-900">Carats (Ct)</th>
            <th class="p-3.5 text-amber-800">Pakka Ratti (0.91)</th>
            <th class="p-3.5">Sunee Ratti (0.90)</th>
            <th class="p-3.5">Milligrams (mg)</th>
            <th class="p-3.5 font-sans">Astrological Sawa Term</th>
          </tr>
        </thead>
        <tbody id="carat-table-body" class="divide-y divide-slate-100 text-slate-700 bg-white">
          {STATIC_CARAT_TO_RATTI.map((row) => (
            <tr class="hover:bg-amber-50/40 transition-colors">
              <td class="p-3.5 font-bold text-slate-900">{row.carats.toFixed(2)} Ct</td>
              <td class="p-3.5 font-bold text-amber-800">{row.rattiPakka.toFixed(3)} Rt</td>
              <td class="p-3.5 text-slate-500">{row.rattiSunee.toFixed(3)} Rt</td>
              <td class="p-3.5 text-slate-500">{row.mg.toFixed(1)} mg</td>
              <td class="p-3.5 font-sans font-medium text-slate-900">{row.sawaInfo.name} ({row.sawaInfo.hindiName})</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Tab 2: Ratti to Carat Table (Hidden by default) -->
    <div id="tab-content-ratti-first" class="hidden overflow-x-auto rounded-2xl border border-slate-200">
      <table class="w-full text-left text-xs font-mono border-collapse table-auto">
        <thead class="bg-slate-50 text-slate-500 border-b border-slate-200 font-semibold uppercase text-[11px] tracking-wider">
          <tr>
            <th class="p-3.5 text-slate-900">Ratti (Rt)</th>
            <th class="p-3.5 text-amber-800">Carats (Pakka 0.91)</th>
            <th class="p-3.5">Carats (Sunee 0.90)</th>
            <th class="p-3.5">Milligrams (mg)</th>
            <th class="p-3.5 font-sans">Hindi Term</th>
          </tr>
        </thead>
        <tbody id="ratti-table-body" class="divide-y divide-slate-100 text-slate-700 bg-white">
          {STATIC_RATTI_TO_CARAT.map((row) => (
            <tr class="hover:bg-amber-50/40 transition-colors">
              <td class="p-3.5 font-bold text-slate-900">{row.ratti.toFixed(2)} Rt</td>
              <td class="p-3.5 font-bold text-amber-800">{row.caratsPakka.toFixed(3)} Ct</td>
              <td class="p-3.5 text-slate-500">{row.caratsSunee.toFixed(3)} Ct</td>
              <td class="p-3.5 text-slate-500">{row.mg.toFixed(1)} mg</td>
              <td class="p-3.5 font-sans font-medium text-slate-900">{row.sawaInfo.hindiName}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Tab 3: Sawa Astrological Scale (Hidden by default) -->
    <div id="tab-content-sawa-scale" class="hidden overflow-x-auto rounded-2xl border border-slate-200">
      <table class="w-full text-left text-xs font-mono border-collapse table-auto">
        <thead class="bg-slate-50 text-slate-500 border-b border-slate-200 font-semibold uppercase text-[11px] tracking-wider">
          <tr>
            <th class="p-3.5 text-amber-800 font-sans">Sawa Name</th>
            <th class="p-3.5 text-slate-900">Ratti</th>
            <th class="p-3.5">Carats (0.91)</th>
            <th class="p-3.5">Milligrams</th>
            <th class="p-3.5 font-sans">Ruling Planet</th>
            <th class="p-3.5 font-sans">Associated Gem</th>
          </tr>
        </thead>
        <tbody id="sawa-table-body" class="divide-y divide-slate-100 text-slate-700 bg-white">
          {SAWA_RATTI_TABLE.map((row) => (
            <tr class="hover:bg-amber-50/40 transition-colors">
              <td class="p-3.5 font-sans font-bold text-amber-800">✨ {row.name} ({row.hindiName})</td>
              <td class="p-3.5 font-bold text-slate-900">{row.ratti.toFixed(2)} Rt</td>
              <td class="p-3.5 font-bold text-slate-900">{row.carat.toFixed(2)} Ct</td>
              <td class="p-3.5 text-slate-500">{row.mg.toFixed(1)} mg</td>
              <td class="p-3.5 font-sans text-slate-900">{row.planet}</td>
              <td class="p-3.5 font-sans text-amber-700 font-medium">{row.gem}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<script>
  const tabBtnCarat = document.getElementById('tab-btn-carat-first');
  const tabBtnRatti = document.getElementById('tab-btn-ratti-first');
  const tabBtnSawa = document.getElementById('tab-btn-sawa-scale');

  const tabContentCarat = document.getElementById('tab-content-carat-first');
  const tabContentRatti = document.getElementById('tab-content-ratti-first');
  const tabContentSawa = document.getElementById('tab-content-sawa-scale');

  const searchInput = document.getElementById('table-search-input') as HTMLInputElement;

  function switchTab(activeTab: 'carat' | 'ratti' | 'sawa') {
    const activeClass = 'px-3 py-1.5 rounded-lg bg-white text-slate-900 shadow-xs font-bold transition-all';
    const inactiveClass = 'px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 transition-all';

    tabBtnCarat!.className = activeTab === 'carat' ? activeClass : inactiveClass;
    tabBtnRatti!.className = activeTab === 'ratti' ? activeClass : inactiveClass;
    tabBtnSawa!.className = activeTab === 'sawa' ? activeClass : inactiveClass;

    tabContentCarat?.classList.toggle('hidden', activeTab !== 'carat');
    tabContentRatti?.classList.toggle('hidden', activeTab !== 'ratti');
    tabContentSawa?.classList.toggle('hidden', activeTab !== 'sawa');
  }

  tabBtnCarat?.addEventListener('click', () => switchTab('carat'));
  tabBtnRatti?.addEventListener('click', () => switchTab('ratti'));
  tabBtnSawa?.addEventListener('click', () => switchTab('sawa'));

  searchInput?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
    const activeTable = document.querySelector('#conversion-tables-section table:not(.hidden) tbody') || document.querySelector('#carat-table-body');
    const rows = document.querySelectorAll('#conversion-tables-section tbody tr');
    
    rows.forEach(row => {
      const text = row.textContent?.toLowerCase() || '';
      (row as HTMLElement).style.display = text.includes(query) ? '' : 'none';
    });
  });
</script>
