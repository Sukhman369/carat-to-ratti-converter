---
import { getSawaInfo, calculateAllUnits } from '../utils/converter';

interface Props {
  initialValue?: number;
  initialUnit?: 'ratti' | 'carat';
  isReverse?: boolean;
}

const { initialValue = 5.25, initialUnit = 'ratti', isReverse = false } = Astro.props;

const defaultUnit = isReverse ? 'carat' : initialUnit;
const defaultVal = isReverse ? 4.78 : initialValue;
const initialConversion = calculateAllUnits(defaultVal, defaultUnit, 0.91);
const initialSawa = getSawaInfo(initialConversion.rattiPakka);
---

<section class="w-full max-w-4xl mx-auto px-4 sm:px-6 pt-6 sm:pt-10 pb-8">
  <!-- Heading & Value Proposition -->
  <div class="text-center space-y-3 mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-50 text-amber-800 text-xs font-semibold uppercase tracking-wider border border-amber-200 shadow-xs">
      <span class="w-2 h-2 rounded-full bg-amber-500"></span>
      <span id="hero-badge">Certified 0.9100 Pakka & 0.9000 Sunee Engine</span>
    </div>
    <h1 id="hero-title" class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 font-display">
      {isReverse ? 'Carat to Ratti Converter' : 'Ratti to Carat Converter'}
    </h1>
    <p id="hero-subtitle" class="text-slate-600 text-sm sm:text-base max-w-xl mx-auto leading-relaxed">
      Precision gemstone weight calculator with instant keystroke calculations, astrological Sawa fractions, and multi-unit matrix.
    </p>
  </div>

  <!-- Master Interactive Card -->
  <div class="rounded-3xl atelier-card-elevated p-6 sm:p-8 space-y-6 glow-gold-sm border border-slate-200">
    <!-- Top Configuration Bar -->
    <div class="flex flex-wrap items-center justify-between gap-3 pb-5 border-b border-slate-100">
      <!-- Standard Toggle: Pakka vs Sunee -->
      <div class="flex items-center gap-1.5 p-1 rounded-xl bg-slate-100 border border-slate-200/80 text-xs font-semibold">
        <button
          type="button"
          id="btn-pakka-ratti"
          class="px-3 py-1.5 rounded-lg bg-white text-slate-900 shadow-xs transition-all font-bold"
          data-ratio="0.91"
        >
          Pakka Ratti (0.91 Ct)
        </button>
        <button
          type="button"
          id="btn-sunee-ratti"
          class="px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 transition-all"
          data-ratio="0.90"
        >
          Sunee / Trade (0.90 Ct)
        </button>
      </div>

      <!-- Quick Preset Actions -->
      <div class="flex items-center gap-2">
        <button
          id="btn-copy-result"
          type="button"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold border border-slate-200 transition-all active:scale-95"
          title="Copy Calculation Summary"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-slate-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
          </svg>
          <span id="copy-text">Copy</span>
        </button>

        <button
          id="btn-share-whatsapp"
          type="button"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-emerald-800 text-xs font-semibold border border-emerald-200 transition-all active:scale-95"
          title="Share via WhatsApp"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-emerald-600" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.301-.15-1.78-.878-2.056-.979-.276-.1-.477-.15-.678.15-.2.301-.778.979-.954 1.18-.176.2-.352.225-.653.075-.301-.15-1.272-.469-2.423-1.496-.896-.799-1.501-1.786-1.677-2.087-.176-.301-.019-.464.132-.614.136-.135.301-.352.452-.527.15-.176.2-.301.301-.502.1-.2.05-.376-.025-.527-.075-.15-.678-1.634-.929-2.238-.244-.588-.493-.508-.678-.517-.176-.009-.377-.009-.578-.009-.2 0-.527.075-.803.376-.276.301-1.054 1.03-1.054 2.512 0 1.482 1.079 2.913 1.23 3.114.15.2 2.124 3.243 5.145 4.548.719.311 1.28.497 1.718.636.722.229 1.379.197 1.898.12.578-.087 1.78-.728 2.031-1.432.251-.704.251-1.307.176-1.432-.075-.126-.276-.201-.577-.351z"/>
          </svg>
          <span>WhatsApp</span>
        </button>
      </div>
    </div>

    <!-- Live Dual Input Converter Block -->
    <div class="grid grid-cols-1 md:grid-cols-[1fr,auto,1fr] items-center gap-4">
      <!-- Input 1: Primary Value -->
      <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/90 space-y-1.5 focus-within:border-amber-500 focus-within:ring-2 focus-within:ring-amber-500/20 transition-all shadow-xs">
        <div class="flex items-center justify-between text-xs font-semibold text-slate-500">
          <span id="input-unit-label">{defaultUnit === 'ratti' ? 'Ratti (रत्ती)' : 'Carats (कैरेट)'}</span>
          <span class="text-[11px] font-mono text-slate-400">Input</span>
        </div>
        <div class="flex items-center gap-2">
          <input
            type="number"
            id="primary-input"
            step="0.01"
            min="0"
            value={defaultVal}
            class="w-full bg-transparent text-3xl sm:text-4xl font-extrabold text-slate-900 font-mono tracking-tight focus:outline-none"
            placeholder="0.00"
          />
          <span id="primary-unit-symbol" class="text-sm font-bold text-amber-700 bg-amber-100 px-2.5 py-1 rounded-lg">
            {defaultUnit === 'ratti' ? 'Rt' : 'Ct'}
          </span>
        </div>
      </div>

      <!-- Swap Direction Button -->
      <div class="flex justify-center">
        <button
          type="button"
          id="btn-swap-units"
          class="w-11 h-11 rounded-2xl bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-300/80 flex items-center justify-center shadow-xs transition-all hover:scale-105 active:scale-95 group"
          title="Swap Conversion Direction"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:rotate-180 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m16 3 4 4-4 4"></path>
            <path d="M20 7H4"></path>
            <path d="m8 21-4-4 4-4"></path>
            <path d="M4 17h16"></path>
          </svg>
        </button>
      </div>

      <!-- Input 2 / Output: Converted Value -->
      <div class="p-4 rounded-2xl bg-amber-50/50 border border-amber-200/90 space-y-1.5 focus-within:border-amber-500 focus-within:ring-2 focus-within:ring-amber-500/20 transition-all shadow-xs">
        <div class="flex items-center justify-between text-xs font-semibold text-amber-900">
          <span id="output-unit-label">{defaultUnit === 'ratti' ? 'Carats (कैरेट)' : 'Ratti (रत्ती)'}</span>
          <span class="text-[11px] font-mono text-amber-700">Result</span>
        </div>
        <div class="flex items-center gap-2">
          <input
            type="number"
            id="secondary-input"
            step="0.01"
            min="0"
            value={isReverse ? initialConversion.rattiPakka : initialConversion.caratsPakka}
            class="w-full bg-transparent text-3xl sm:text-4xl font-extrabold text-amber-900 font-mono tracking-tight focus:outline-none"
            placeholder="0.00"
          />
          <span id="secondary-unit-symbol" class="text-sm font-bold text-amber-800 bg-amber-200/70 px-2.5 py-1 rounded-lg">
            {defaultUnit === 'ratti' ? 'Ct' : 'Rt'}
          </span>
        </div>
      </div>
    </div>

    <!-- Auspicious Sawa Astrological Banner -->
    <div id="sawa-banner" class="p-4 rounded-2xl bg-amber-50/80 border border-amber-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-xl bg-amber-500 text-white flex items-center justify-center font-bold text-sm shadow-xs">
          ✨
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span id="sawa-title" class="text-sm font-bold text-slate-900 font-display">
              {initialSawa.name} ({initialSawa.hindiName})
            </span>
            <span id="sawa-badge" class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-200 text-amber-900">
              {initialSawa.status.toUpperCase()}
            </span>
          </div>
          <p id="sawa-desc" class="text-xs text-slate-600 mt-0.5">
            {initialSawa.description}
          </p>
        </div>
      </div>
      <div class="text-xs font-mono text-slate-600 sm:text-right">
        <div>Planet: <span id="sawa-planet" class="font-bold text-slate-900">{initialSawa.planet || 'Universal'}</span></div>
        <div>Gem: <span id="sawa-gem" class="font-bold text-amber-800">{initialSawa.gem || 'All Gemstones'}</span></div>
      </div>
    </div>

    <!-- Synchronous 6-Unit Metric Live Matrix -->
    <div class="space-y-3 pt-2">
      <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="18" height="18" x="3" y="3" rx="2"></rect>
          <path d="M3 9h18"></path>
          <path d="M9 21V9"></path>
        </svg>
        <span>Synchronous Multi-Unit Breakdown</span>
      </h3>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3">
        <!-- Carats Tile -->
        <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
          <span class="text-[11px] font-semibold text-slate-500">Carats (Ct)</span>
          <div id="tile-carats" class="text-base font-extrabold text-slate-900 font-mono">
            {initialConversion.caratsPakka.toFixed(3)}
          </div>
        </div>

        <!-- Ratti (Pakka) Tile -->
        <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
          <span class="text-[11px] font-semibold text-slate-500">Pakka Ratti (0.91)</span>
          <div id="tile-ratti-pakka" class="text-base font-extrabold text-slate-900 font-mono">
            {initialConversion.rattiPakka.toFixed(3)}
          </div>
        </div>

        <!-- Milligrams Tile -->
        <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
          <span class="text-[11px] font-semibold text-slate-500">Milligrams (mg)</span>
          <div id="tile-mg" class="text-base font-extrabold text-slate-900 font-mono">
            {initialConversion.mg.toFixed(1)}
          </div>
        </div>

        <!-- Grams Tile -->
        <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
          <span class="text-[11px] font-semibold text-slate-500">Grams (g)</span>
          <div id="tile-grams" class="text-base font-extrabold text-slate-900 font-mono">
            {initialConversion.grams.toFixed(4)}
          </div>
        </div>

        <!-- Cents / Points Tile -->
        <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
          <span class="text-[11px] font-semibold text-slate-500">Cents / Points</span>
          <div id="tile-cents" class="text-base font-extrabold text-slate-900 font-mono">
            {initialConversion.cents.toFixed(1)}
          </div>
        </div>

        <!-- Grains Tile -->
        <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
          <span class="text-[11px] font-semibold text-slate-500">Grains (gr)</span>
          <div id="tile-grains" class="text-base font-extrabold text-slate-900 font-mono">
            {initialConversion.grains.toFixed(2)}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Keystroke Reactive Calculation Engine -->
<script>
  import { calculateAllUnits, getSawaInfo } from '../utils/converter';

  let currentUnit = 'ratti';
  let currentRatio = 0.91;

  const primaryInput = document.getElementById('primary-input') as HTMLInputElement;
  const secondaryInput = document.getElementById('secondary-input') as HTMLInputElement;
  const btnSwap = document.getElementById('btn-swap-units');
  const btnPakka = document.getElementById('btn-pakka-ratti');
  const btnSunee = document.getElementById('btn-sunee-ratti');
  const btnCopy = document.getElementById('btn-copy-result');
  const btnShare = document.getElementById('btn-share-whatsapp');

  const inputLabel = document.getElementById('input-unit-label');
  const outputLabel = document.getElementById('output-unit-label');
  const primaryUnitSymbol = document.getElementById('primary-unit-symbol');
  const secondaryUnitSymbol = document.getElementById('secondary-unit-symbol');

  const tileCarats = document.getElementById('tile-carats');
  const tileRattiPakka = document.getElementById('tile-ratti-pakka');
  const tileMg = document.getElementById('tile-mg');
  const tileGrams = document.getElementById('tile-grams');
  const tileCents = document.getElementById('tile-cents');
  const tileGrains = document.getElementById('tile-grains');

  const sawaTitle = document.getElementById('sawa-title');
  const sawaBadge = document.getElementById('sawa-badge');
  const sawaDesc = document.getElementById('sawa-desc');
  const sawaPlanet = document.getElementById('sawa-planet');
  const sawaGem = document.getElementById('sawa-gem');

  function updateCalculations(source: 'primary' | 'secondary' = 'primary') {
    const val = parseFloat(source === 'primary' ? primaryInput.value : secondaryInput.value);

    if (isNaN(val) || val < 0) {
      return;
    }

    const effectiveUnit = source === 'primary' 
      ? currentUnit 
      : (currentUnit === 'ratti' ? 'carat' : 'ratti');

    const result = calculateAllUnits(val, effectiveUnit as 'ratti' | 'carat', currentRatio);

    if (source === 'primary') {
      secondaryInput.value = currentUnit === 'ratti' 
        ? result.caratsPakka.toFixed(3) 
        : result.rattiPakka.toFixed(3);
    } else {
      primaryInput.value = currentUnit === 'ratti' 
        ? result.rattiPakka.toFixed(3) 
        : result.caratsPakka.toFixed(3);
    }

    if (tileCarats) tileCarats.innerText = result.caratsPakka.toFixed(3);
    if (tileRattiPakka) tileRattiPakka.innerText = result.rattiPakka.toFixed(3);
    if (tileMg) tileMg.innerText = result.mg.toFixed(1);
    if (tileGrams) tileGrams.innerText = result.grams.toFixed(4);
    if (tileCents) tileCents.innerText = result.cents.toFixed(1);
    if (tileGrains) tileGrains.innerText = result.grains.toFixed(2);

    const sawaInfo = getSawaInfo(result.rattiPakka);
    if (sawaTitle) sawaTitle.innerText = `${sawaInfo.name} (${sawaInfo.hindiName})`;
    if (sawaBadge) {
      sawaBadge.innerText = sawaInfo.status.toUpperCase();
      sawaBadge.className = sawaInfo.status === 'auspicious'
        ? 'px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-900'
        : sawaInfo.status === 'neutral'
          ? 'px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-100 text-blue-900'
          : 'px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-900';
    }
    if (sawaDesc) sawaDesc.innerText = sawaInfo.description;
    if (sawaPlanet) sawaPlanet.innerText = sawaInfo.planet || 'Universal';
    if (sawaGem) sawaGem.innerText = sawaInfo.gem || 'All Gemstones';
  }

  primaryInput?.addEventListener('input', () => updateCalculations('primary'));
  secondaryInput?.addEventListener('input', () => updateCalculations('secondary'));

  btnSwap?.addEventListener('click', () => {
    currentUnit = currentUnit === 'ratti' ? 'carat' : 'ratti';
    if (inputLabel) inputLabel.innerText = currentUnit === 'ratti' ? 'Ratti (रत्ती)' : 'Carats (कैरेट)';
    if (outputLabel) outputLabel.innerText = currentUnit === 'ratti' ? 'Carats (कैरेट)' : 'Ratti (रत्ती)';
    if (primaryUnitSymbol) primaryUnitSymbol.innerText = currentUnit === 'ratti' ? 'Rt' : 'Ct';
    if (secondaryUnitSymbol) secondaryUnitSymbol.innerText = currentUnit === 'ratti' ? 'Ct' : 'Rt';
    updateCalculations('primary');
  });

  btnPakka?.addEventListener('click', () => {
    currentRatio = 0.91;
    btnPakka.className = 'px-3 py-1.5 rounded-lg bg-white text-slate-900 shadow-xs transition-all font-bold';
    btnSunee!.className = 'px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 transition-all';
    updateCalculations('primary');
  });

  btnSunee?.addEventListener('click', () => {
    currentRatio = 0.90;
    btnSunee.className = 'px-3 py-1.5 rounded-lg bg-white text-slate-900 shadow-xs transition-all font-bold';
    btnPakka!.className = 'px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 transition-all';
    updateCalculations('primary');
  });

  btnCopy?.addEventListener('click', () => {
    const pVal = primaryInput.value;
    const sVal = secondaryInput.value;
    const pUnit = currentUnit === 'ratti' ? 'Ratti' : 'Carats';
    const sUnit = currentUnit === 'ratti' ? 'Carats' : 'Ratti';
    const summary = `${pVal} ${pUnit} = ${sVal} ${sUnit} (${tileMg?.innerText} mg) | Calculated via rattitocarat.com`;
    navigator.clipboard.writeText(summary).then(() => {
      const copyText = document.getElementById('copy-text');
      if (copyText) {
        copyText.innerText = 'Copied!';
        setTimeout(() => { copyText.innerText = 'Copy'; }, 2000);
      }
    });
  });

  btnShare?.addEventListener('click', () => {
    const pVal = primaryInput.value;
    const sVal = secondaryInput.value;
    const pUnit = currentUnit === 'ratti' ? 'Ratti' : 'Carats';
    const sUnit = currentUnit === 'ratti' ? 'Carats' : 'Ratti';
    const text = encodeURIComponent(`*Gemstone Weight Conversion*\n${pVal} ${pUnit} = *${sVal} ${sUnit}*\nWeight in Milligrams: ${tileMg?.innerText} mg\nCalculated on: https://rattitocarat.com`);
    window.open(`https://api.whatsapp.com/send?text=${text}`, '_blank');
  });

  window.addEventListener('load-gemstone-preset', (e: any) => {
    const ratti = e.detail?.ratti;
    if (ratti && primaryInput) {
      if (currentUnit !== 'ratti') {
        btnSwap?.click();
      }
      primaryInput.value = ratti.toString();
      updateCalculations('primary');
      primaryInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  });
</script>
