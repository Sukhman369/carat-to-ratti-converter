---
---

<section id="body-weight" class="w-full max-w-4xl mx-auto py-12 px-4 sm:px-6">
  <div class="glass-panel-elevated rounded-3xl p-6 sm:p-8 border border-white/10 relative overflow-hidden">
    <!-- Ambient Accent Glow -->
    <div class="absolute -top-20 -left-20 w-64 h-64 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Section Header -->
    <div class="text-left space-y-2 mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 text-amber-400 text-xs font-semibold uppercase tracking-wider border border-amber-500/20">
        <span>⚖️ Vedic Dosage Formula</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-white font-display" data-i18n="bodyWeightTitle">
        Vedic Body-Weight Gemstone Dosage Calculator
      </h2>
      <p class="text-zinc-400 text-sm max-w-2xl leading-relaxed" data-i18n="bodyWeightSubtitle">
        According to ancient Vedic astrology, gemstone weight must correlate with your body mass (1 Ratti per 10–12 kg of body weight).
      </p>
    </div>

    <!-- Interactive Body Weight Controls & Results -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <!-- Left Column: Slider & Weight Input -->
      <div class="lg:col-span-6 space-y-6">
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <label for="bw-slider" class="text-xs font-medium text-zinc-300" data-i18n="yourWeight">
              Your Body Weight
            </label>
            <div class="flex items-center gap-1.5 px-3 py-1 rounded-lg bg-black/50 border border-white/10">
              <input
                type="number"
                id="bw-num-input"
                value="65"
                min="35"
                max="140"
                class="w-12 bg-transparent text-right font-mono font-bold text-amber-400 text-sm outline-none"
              />
              <span class="text-xs font-mono text-zinc-400">kg</span>
            </div>
          </div>

          <!-- Range Slider -->
          <input
            type="range"
            id="bw-slider"
            min="35"
            max="140"
            value="65"
            class="w-full h-2 bg-zinc-800 rounded-lg appearance-none cursor-pointer accent-amber-500"
          />

          <div class="flex justify-between text-[11px] font-mono text-zinc-500">
            <span>35 kg</span>
            <span>65 kg (Avg)</span>
            <span>100 kg</span>
            <span>140 kg</span>
          </div>
        </div>

        <div class="p-4 rounded-xl bg-black/40 border border-white/5 space-y-1.5 text-xs text-zinc-400">
          <div class="flex items-center gap-2 text-zinc-300 font-semibold">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
            <span>Vedic Weight Multiplier</span>
          </div>
          <p class="leading-relaxed">
            Body Weight (kg) ÷ 12 gives the minimum baseline, while Body Weight (kg) ÷ 10 provides full astrological potency.
          </p>
        </div>
      </div>

      <!-- Right Column: Live Dosage Output Card -->
      <div class="lg:col-span-6">
        <div class="p-6 rounded-2xl bg-gradient-to-br from-amber-500/15 via-black/40 to-black/60 border border-amber-500/30 space-y-5">
          <!-- Recommended Range -->
          <div class="space-y-1">
            <span class="text-xs font-medium text-zinc-400 block" data-i18n="weightRange">
              Recommended Weight Range
            </span>
            <div class="flex items-baseline gap-2">
              <span id="bw-ratti-range" class="text-2xl font-bold font-mono text-amber-300">5.42 – 6.50</span>
              <span class="text-xs font-mono text-amber-400">Ratti</span>
              <span class="text-xs text-zinc-500">/</span>
              <span id="bw-carat-range" class="text-sm font-mono text-zinc-300">4.93 – 5.92 Ct</span>
            </div>
          </div>

          <!-- Auspicious Sawa Recommendation -->
          <div class="pt-4 border-t border-white/10 space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold text-zinc-300" data-i18n="recommendedSawa">
                Recommended Auspicious Sawa Weight
              </span>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-400 text-black uppercase">Best Fit</span>
            </div>
            
            <div class="flex items-center justify-between p-3 rounded-xl bg-black/60 border border-amber-500/20">
              <div>
                <div id="bw-sawa-name" class="text-base font-bold text-white">Sawa Paanch Ratti</div>
                <div id="bw-sawa-val" class="text-xs font-mono text-amber-400">5.25 Ratti (4.78 Carats)</div>
              </div>
              <button
                type="button"
                id="btn-load-bw-calc"
                class="btn-pill-primary text-xs py-1.5 px-3"
              >
                Use in Calculator
              </button>
            </div>
          </div>

          <p class="text-[11px] text-zinc-500 leading-normal" data-i18n="bodyWeightNote">
            Consult a qualified Vedic astrologer before purchasing high-potency gemstones like Neelam or Manik.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Client Script for Body Weight Calculator -->
<script>
  import { calculateBodyWeightDosage } from '../utils/converter';

  const bwSlider = document.getElementById('bw-slider') as HTMLInputElement;
  const bwNumInput = document.getElementById('bw-num-input') as HTMLInputElement;
  const bwRattiRange = document.getElementById('bw-ratti-range')!;
  const bwCaratRange = document.getElementById('bw-carat-range')!;
  const bwSawaName = document.getElementById('bw-sawa-name')!;
  const bwSawaVal = document.getElementById('bw-sawa-val')!;
  const btnLoadBwCalc = document.getElementById('btn-load-bw-calc')!;

  let currentSawaRatti = 5.25;

  function updateBwDosage(kg: number) {
    const data = calculateBodyWeightDosage(kg, 'pakka');
    bwRattiRange.textContent = `${data.minRatti.toFixed(2)} – ${data.maxRatti.toFixed(2)}`;
    bwCaratRange.textContent = `${data.minCarat.toFixed(2)} – ${data.maxCarat.toFixed(2)} Ct`;
    
    bwSawaName.textContent = data.recommendedSawa.name;
    bwSawaVal.textContent = `${data.recommendedSawa.ratti.toFixed(2)} Ratti (${data.recommendedSawa.carats.toFixed(2)} Carats)`;
    currentSawaRatti = data.recommendedSawa.ratti;
  }

  bwSlider?.addEventListener('input', () => {
    const val = parseInt(bwSlider.value, 10);
    bwNumInput.value = val.toString();
    updateBwDosage(val);
  });

  bwNumInput?.addEventListener('input', () => {
    let val = parseInt(bwNumInput.value, 10);
    if (isNaN(val)) val = 65;
    bwSlider.value = val.toString();
    updateBwDosage(val);
  });

  btnLoadBwCalc?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('load-gemstone-preset', {
      detail: { ratti: currentSawaRatti, mode: 'rattiToCarat' }
    }));
  });

  // Initial calculation
  updateBwDosage(65);
</script>
