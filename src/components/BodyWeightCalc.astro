---
---

<section id="body-weight-section" class="w-full max-w-4xl mx-auto px-4 sm:px-6 py-6 sm:py-8">
  <div class="rounded-3xl atelier-card-elevated p-6 sm:p-8 space-y-6 border border-slate-200 shadow-sm">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-5 border-b border-slate-100">
      <div class="space-y-1">
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-amber-50 text-amber-800 text-[11px] font-semibold uppercase tracking-wider border border-amber-200">
          <span>🧘 Vedic Jyotish Dosage Rule</span>
        </div>
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 font-display" data-i18n="bodyWeightTitle">
          Calculate Gemstone Weight by Body Weight
        </h2>
        <p class="text-xs sm:text-sm text-slate-600" data-i18n="bodyWeightSubtitle">
          Ancient Vedic formula: 1 Ratti per 10 to 12 kg of body mass with nearest auspicious Sawa target.
        </p>
      </div>

      <div class="px-3 py-1.5 rounded-xl bg-slate-50 border border-slate-200 text-xs font-mono text-slate-700 font-semibold self-start sm:self-auto">
        Formula: Weight ÷ 10 to 12
      </div>
    </div>

    <!-- Interactive Body Weight Slider & Input -->
    <div class="space-y-4">
      <div class="flex items-center justify-between">
        <label for="weight-range-slider" class="text-xs font-semibold uppercase tracking-wider text-slate-500">
          Your Body Weight (Kilograms)
        </label>
        <div class="flex items-center gap-2">
          <input
            type="number"
            id="weight-number-input"
            min="30"
            max="150"
            value="65"
            class="w-20 px-3 py-1.5 rounded-xl bg-slate-50 border border-slate-300 text-right font-mono font-extrabold text-slate-900 focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500 text-base"
          />
          <span class="text-xs font-bold text-slate-600">kg</span>
        </div>
      </div>

      <!-- Range Slider -->
      <div class="relative py-2">
        <input
          type="range"
          id="weight-range-slider"
          min="35"
          max="140"
          value="65"
          step="1"
          class="w-full h-2.5 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-amber-600 focus:outline-none"
        />
        <div class="flex justify-between text-[10px] font-mono text-slate-500 mt-1">
          <span>35 kg</span>
          <span>60 kg</span>
          <span>85 kg</span>
          <span>110 kg</span>
          <span>140 kg</span>
        </div>
      </div>
    </div>

    <!-- Calculated Dosage Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
      <!-- Baseline Minimum Dosage -->
      <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 space-y-1.5 shadow-xs">
        <span class="text-xs font-semibold text-slate-500">Baseline (Weight ÷ 12)</span>
        <div id="dosage-min" class="text-2xl font-extrabold text-slate-900 font-mono">
          5.42 Rt
        </div>
        <p class="text-[11px] text-slate-500">Minimum threshold required for physical resonance</p>
      </div>

      <!-- Full Potency Dosage -->
      <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 space-y-1.5 shadow-xs">
        <span class="text-xs font-semibold text-slate-500">Full Potency (Weight ÷ 10)</span>
        <div id="dosage-max" class="text-2xl font-extrabold text-slate-900 font-mono">
          6.50 Rt
        </div>
        <p class="text-[11px] text-slate-500">Maximum standard prescribed dosage</p>
      </div>

      <!-- Recommended Auspicious Sawa Weight -->
      <div class="p-4 rounded-2xl bg-amber-50 border border-amber-200 space-y-1.5 shadow-xs">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-amber-900">Recommended Sawa</span>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-200 text-amber-900">AUSPICIOUS</span>
        </div>
        <div id="dosage-sawa" class="text-2xl font-extrabold text-amber-900 font-mono">
          6.25 Rt (5.69 Ct)
        </div>
        <p id="dosage-sawa-name" class="text-[11px] text-amber-800 font-medium">
          Sawa Chhah Ratti (सवा छह रत्ती)
        </p>
      </div>
    </div>

    <!-- Action Button: Apply to Hero Calculator -->
    <div class="flex justify-end pt-2">
      <button
        type="button"
        id="btn-apply-dosage"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold shadow-xs transition-all hover:scale-105 active:scale-95"
      >
        <span>Use This Weight in Calculator</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m5 12 7-7 7 7"></path>
          <path d="M12 19V5"></path>
        </svg>
      </button>
    </div>
  </div>
</section>

<script>
  import { calculateBodyWeightDosage } from '../utils/converter';
  import { getStoredLanguage } from '../utils/i18n';

  const slider = document.getElementById('weight-range-slider') as HTMLInputElement;
  const numInput = document.getElementById('weight-number-input') as HTMLInputElement;
  const dosageMin = document.getElementById('dosage-min');
  const dosageMax = document.getElementById('dosage-max');
  const dosageSawa = document.getElementById('dosage-sawa');
  const dosageSawaName = document.getElementById('dosage-sawa-name');
  const btnApply = document.getElementById('btn-apply-dosage');

  let currentSawaWeight = 6.25;

  function updateWeight(weightKg: number) {
    if (isNaN(weightKg) || weightKg <= 0) return;
    const res = calculateBodyWeightDosage(weightKg);
    currentSawaWeight = res.recommendedSawaRatti;

    const isHi = getStoredLanguage() === 'hi';

    if (dosageMin) dosageMin.innerText = `${res.minRatti.toFixed(2)} Rt`;
    if (dosageMax) dosageMax.innerText = `${res.maxRatti.toFixed(2)} Rt`;
    if (dosageSawa) dosageSawa.innerText = `${res.recommendedSawaRatti.toFixed(2)} Rt (${res.recommendedCarats.toFixed(2)} Ct)`;
    if (dosageSawaName) dosageSawaName.innerText = isHi ? res.sawaInfo.hindiName : `${res.sawaInfo.name} (${res.sawaInfo.hindiName})`;
  }

  slider?.addEventListener('input', (e) => {
    const val = parseFloat((e.target as HTMLInputElement).value);
    if (numInput) numInput.value = val.toString();
    updateWeight(val);
  });

  numInput?.addEventListener('input', (e) => {
    const val = parseFloat((e.target as HTMLInputElement).value);
    if (slider && !isNaN(val)) slider.value = val.toString();
    updateWeight(val);
  });

  btnApply?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('load-gemstone-preset', {
      detail: { ratti: currentSawaWeight }
    }));
  });

  window.addEventListener('language-changed', () => {
    const val = parseFloat(numInput?.value || '65');
    updateWeight(val);
  });
</script>
