---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Offline Mode · Client-Side Converter | Ratti to Carat"
  description="You are currently offline. The Ratti to Carat conversion engine runs 100% locally in your browser with zero internet required."
  canonicalUrl="https://rattitocarat.com/offline"
>
  <Navbar />

  <main class="relative max-w-2xl mx-auto px-4 sm:px-6 py-12 sm:py-16 space-y-8">
    <!-- Elevated Master Offline Card -->
    <div class="rounded-3xl atelier-card-elevated p-8 sm:p-10 border border-slate-200/90 shadow-lg text-center space-y-7 glow-gold-sm">
      
      <!-- Icon & Status Pill -->
      <div class="flex flex-col items-center gap-3">
        <div class="w-16 h-16 rounded-2xl bg-amber-500/10 border border-amber-300/60 flex items-center justify-center text-amber-700 shadow-inner">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-amber-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="1" x2="23" y1="1" y2="23"/>
            <path d="M16.72 11.06A10.94 10.94 0 0 1 19 12.55"/>
            <path d="M5 12.55a10.94 10.94 0 0 1 5.17-2.39"/>
            <path d="M10.71 5.05A16 16 0 0 1 22.58 9"/>
            <path d="M1.42 9a15.91 15.91 0 0 1 4.7-2.88"/>
            <path d="M8.53 16.11a6 6 0 0 1 6.95 0"/>
            <line x1="12" x2="12.01" y1="20" y2="20"/>
          </svg>
        </div>
        <span class="px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 text-xs font-mono font-semibold border border-emerald-200 tracking-wide flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>100% Offline Functional Engine</span>
        </span>
      </div>

      <!-- Main Headline & Explanation -->
      <div class="space-y-2.5">
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 font-display">
          No Internet Connection Detected
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed max-w-md mx-auto">
          Whether you are in an underground jewelry bazaar or a low-signal area, <strong>rattitocarat.com</strong> runs completely in your browser without requiring network data.
        </p>
      </div>

      <!-- Mini Embedded Offline Conversion Widget -->
      <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200/90 text-left space-y-4 shadow-xs">
        <span class="text-xs font-bold text-slate-800 uppercase tracking-wider block">
          💎 Live Offline Calculator
        </span>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 items-center">
          <!-- Input 1: Ratti -->
          <div class="p-3 rounded-xl bg-white border border-slate-200 space-y-1">
            <label for="offline-ratti-input" class="text-[11px] font-semibold text-slate-500">Ratti (Pakka 0.91)</label>
            <div class="flex items-center gap-1.5">
              <input
                type="number"
                id="offline-ratti-input"
                step="0.01"
                min="0"
                value="5.25"
                class="w-full bg-transparent font-mono font-extrabold text-slate-900 text-xl focus:outline-none"
              />
              <span class="text-xs font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded">Rt</span>
            </div>
          </div>

          <!-- Input 2: Carats -->
          <div class="p-3 rounded-xl bg-amber-50/60 border border-amber-200 space-y-1">
            <label for="offline-carat-input" class="text-[11px] font-semibold text-amber-900">Equivalent Carats (Ct)</label>
            <div class="flex items-center gap-1.5">
              <input
                type="number"
                id="offline-carat-input"
                step="0.01"
                min="0"
                value="4.78"
                class="w-full bg-transparent font-mono font-extrabold text-amber-900 text-xl focus:outline-none"
              />
              <span class="text-xs font-bold text-amber-800 bg-amber-200/80 px-2 py-0.5 rounded">Ct</span>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-between text-[11px] font-mono text-slate-500 pt-1 border-t border-slate-200/60">
          <span>Milligrams: <strong id="offline-mg-val" class="text-slate-800 font-bold">955.5 mg</strong></span>
          <span>Sawa Status: <strong class="text-amber-800 font-bold">Sawa Paanch (Auspicious)</strong></span>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 pt-1">
        <button
          type="button"
          id="btn-try-reconnect"
          class="h-12 px-6 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-sm shadow-sm flex items-center justify-center gap-2.5 transition-all hover:scale-[1.02] active:scale-95 cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12.55a11 11 0 0 1 14.08 0"/>
            <path d="M1.42 9a16 16 0 0 1 21.16 0"/>
            <path d="M8.53 16.11a6 6 0 0 1 6.95 0"/>
            <line x1="12" x2="12.01" y1="20" y2="20"/>
          </svg>
          <span>Check Connection</span>
        </button>

        <a
          href="/"
          class="h-12 px-5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold text-sm border border-slate-200 flex items-center justify-center gap-2 transition-all hover:scale-[1.02] active:scale-95"
        >
          <span>Master Tool Hub</span>
        </a>
      </div>

      <!-- Emergency Quick Reference Standards -->
      <div class="pt-5 border-t border-slate-100 text-left">
        <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-2">
          <span class="text-xs font-bold text-slate-700 block">⚡ Quick Offline Constants</span>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-[11px] font-mono text-center">
            <div class="p-2 rounded-xl bg-white border border-slate-200">
              <span class="text-slate-400 block text-[10px]">1 Pakka Rt</span>
              <span class="font-bold text-slate-900">0.9100 Ct</span>
            </div>
            <div class="p-2 rounded-xl bg-white border border-slate-200">
              <span class="text-slate-400 block text-[10px]">1 Carat</span>
              <span class="font-bold text-slate-900">1.0989 Rt</span>
            </div>
            <div class="p-2 rounded-xl bg-white border border-slate-200">
              <span class="text-slate-400 block text-[10px]">1 Carat</span>
              <span class="font-bold text-slate-900">200.0 mg</span>
            </div>
            <div class="p-2 rounded-xl bg-white border border-slate-200">
              <span class="text-slate-400 block text-[10px]">1 Pakka Rt</span>
              <span class="font-bold text-slate-900">182.0 mg</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </main>

  <Footer />
</Layout>

<!-- Client-Side Offline Math & Online Auto-Reconnect Script -->
<script>
  const rattiInput = document.getElementById('offline-ratti-input') as HTMLInputElement;
  const caratInput = document.getElementById('offline-carat-input') as HTMLInputElement;
  const mgDisplay = document.getElementById('offline-mg-val');
  const btnReconnect = document.getElementById('btn-try-reconnect');

  function calculateOffline(from: 'ratti' | 'carat') {
    const ratio = 0.91;
    if (from === 'ratti') {
      const rVal = parseFloat(rattiInput.value);
      if (!isNaN(rVal) && rVal >= 0) {
        const ct = rVal * ratio;
        caratInput.value = ct.toFixed(2);
        if (mgDisplay) mgDisplay.innerText = `${(ct * 200).toFixed(1)} mg`;
      }
    } else {
      const cVal = parseFloat(caratInput.value);
      if (!isNaN(cVal) && cVal >= 0) {
        const rt = cVal / ratio;
        rattiInput.value = rt.toFixed(2);
        if (mgDisplay) mgDisplay.innerText = `${(cVal * 200).toFixed(1)} mg`;
      }
    }
  }

  rattiInput?.addEventListener('input', () => calculateOffline('ratti'));
  caratInput?.addEventListener('input', () => calculateOffline('carat'));

  // Reconnect check
  btnReconnect?.addEventListener('click', () => {
    if (navigator.onLine) {
      window.location.href = '/';
    } else {
      alert('Still offline. Please check your WiFi or mobile data connection.');
    }
  });

  // Auto-reload when connection is restored
  window.addEventListener('online', () => {
    window.location.reload();
  });
</script>
