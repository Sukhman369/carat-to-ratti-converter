---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import { SAWA_RATTI_TABLE } from '../utils/converter';
import GemstoneGrid from '../components/GemstoneGrid.astro';
import FaqSection from '../components/FaqSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Sawa Ratti Astrological Scale & Reference Chart (सवा रत्ती चार्ट) | Vedic Gem Guide"
  description="Complete Vedic astrological reference chart for Sawa Ratti weights (1.25 to 12.25 Ratti). Learn the meaning of Sawa, Saadhe, and Paune weights across all 9 ruling planets."
  canonicalUrl="https://rattitocarat.com/sawa-ratti-chart"
>
  <Navbar />
  <main class="relative space-y-8 py-4">
    <!-- Breadcrumbs -->
    <div class="max-w-5xl mx-auto px-4 sm:px-6 pt-4">
      <nav class="flex items-center gap-2 text-xs text-slate-500 font-mono">
        <a href="/" class="hover:text-amber-700 transition-colors">Home</a>
        <span>/</span>
        <span class="text-slate-800 font-semibold">Sawa Ratti Chart</span>
      </nav>
    </div>

    <!-- Header Section -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 pt-4 text-center space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-50 text-amber-800 text-xs font-semibold uppercase tracking-wider border border-amber-200 shadow-xs">
        <span>✨ Sacred Vedic Numerology</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 font-display">
        The Sawa Ratti Astrological Reference Scale
      </h1>
      <p class="text-slate-600 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
        Why Vedic astrologers prescribe gemstones with a +0.25 Ratti fraction and the planetary significance of each weight.
      </p>
    </section>

    <!-- Master Sawa Reference Table -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="p-6 sm:p-8 rounded-3xl atelier-card border border-slate-200 space-y-6 shadow-sm">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-bold text-slate-900 font-display">
            Complete Sawa Ratti Matrix (1.25 to 12.25 Rt)
          </h2>
          <span class="text-xs font-mono font-bold text-amber-800 bg-amber-50 px-2.5 py-1 rounded-lg border border-amber-200">
            1 Pakka Ratti = 0.91 Ct
          </span>
        </div>

        <div class="overflow-x-auto rounded-2xl border border-slate-200">
          <table class="w-full text-left text-xs border-collapse">
            <thead class="bg-slate-50 text-slate-500 border-b border-slate-200 font-mono text-[11px] uppercase tracking-wider">
              <tr>
                <th class="p-3.5 text-amber-900">Sawa Fraction</th>
                <th class="p-3.5 text-slate-900">Weight (Ratti)</th>
                <th class="p-3.5 text-slate-900">Carats (0.91)</th>
                <th class="p-3.5">Milligrams</th>
                <th class="p-3.5 font-sans">Ruling Planet</th>
                <th class="p-3.5 font-sans">Associated Gemstone</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 font-mono text-slate-700 bg-white">
              {SAWA_RATTI_TABLE.map((row) => (
                <tr class="hover:bg-amber-50/40 transition-colors">
                  <td class="p-3.5 font-sans font-bold text-amber-800 flex items-center gap-1.5">
                    <span>✨</span> {row.name} ({row.hindiName})
                  </td>
                  <td class="p-3.5 font-bold text-slate-900">{row.ratti.toFixed(2)} Rt</td>
                  <td class="p-3.5 font-bold text-slate-900">{row.carat.toFixed(2)} Ct</td>
                  <td class="p-3.5 text-slate-500">{row.mg.toFixed(1)} mg</td>
                  <td class="p-3.5 font-sans text-slate-900 font-medium">{row.planet}</td>
                  <td class="p-3.5 font-sans text-amber-800 font-semibold">{row.gem}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Deep Astrological Fraction Meaning -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-amber-50/70 border border-amber-200 space-y-3 shadow-xs">
          <div class="flex items-center gap-2">
            <span class="text-xl">🌟</span>
            <h3 class="text-base font-bold text-amber-900 font-display">Sawa (+0.25 Ratti)</h3>
          </div>
          <p class="text-xs text-slate-700 leading-relaxed">
            Derived from <em>Sapada</em> in Sanskrit, Sawa symbolizes growth, expansion, and positive momentum. It is universally considered the most auspicious fraction for wearing astrological gemstones.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-blue-50/70 border border-blue-200 space-y-3 shadow-xs">
          <div class="flex items-center gap-2">
            <span class="text-xl">⚖️</span>
            <h3 class="text-base font-bold text-blue-900 font-display">Saadhe (+0.50 Ratti)</h3>
          </div>
          <p class="text-xs text-slate-700 leading-relaxed">
            Derived from <em>Sardha</em>, Saadhe represents balance, stability, and neutrality. Astrologers consider it acceptable for standard remedial wear where expansion is not strictly necessary.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-rose-50/70 border border-rose-200 space-y-3 shadow-xs">
          <div class="flex items-center gap-2">
            <span class="text-xl">🚫</span>
            <h3 class="text-base font-bold text-rose-900 font-display">Paune (+0.75 Ratti)</h3>
          </div>
          <p class="text-xs text-slate-700 leading-relaxed">
            Derived from <em>Padona</em> (one-quarter less than next whole), Paune is traditionally associated with loss or incompleteness in orthodox North Indian Jyotish and is avoided.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <FaqSection />
  </main>
  <Footer />
</Layout>
