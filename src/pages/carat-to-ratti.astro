---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import HeroCalculator from '../components/HeroCalculator.astro';
import ConversionTables from '../components/ConversionTables.astro';
import ExplainerSection from '../components/ExplainerSection.astro';
import FaqSection from '../components/FaqSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Carat to Ratti Converter | Instant Gemstone Weight Calculator (0.91 Pakka)"
  description="Convert Carats (Ct) to Ratti instantly using certified 0.91 Pakka Ratti ratio and 0.90 Sunee trade ratio. Includes 0.25 to 15 Ct conversion tables and astrological Sawa analysis."
  canonicalUrl="https://rattitocarat.com/carat-to-ratti"
>
  <Navbar />
  <main class="relative space-y-8 py-4">
    <!-- Breadcrumbs -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 pt-4">
      <nav class="flex items-center gap-2 text-xs text-slate-500 font-mono">
        <a href="/" class="hover:text-amber-700 transition-colors">Home</a>
        <span>/</span>
        <span class="text-slate-800 font-semibold">Carat to Ratti</span>
      </nav>
    </div>

    <!-- Hero Calculator (Carat Intent) -->
    <HeroCalculator initialUnit="carat" isReverse={true} />

    <!-- Static Quick Formula Banner -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="p-6 rounded-2xl atelier-card border border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-xs">
        <div>
          <h2 class="text-base font-bold text-slate-900 font-display">Carat to Ratti Conversion Formula</h2>
          <p class="text-xs text-slate-600 mt-1">
            To convert Carats to Ratti, divide the Carat weight by <strong>0.91</strong> (for Pakka Ratti) or multiply by <strong>1.0989</strong>.
          </p>
        </div>
        <div class="px-4 py-2 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 font-mono font-bold text-sm shrink-0">
          Ratti = Carats ÷ 0.91
        </div>
      </div>
    </div>

    <!-- Conversion Tables -->
    <ConversionTables />

    <!-- Educational & Explainer -->
    <ExplainerSection />

    <!-- FAQ -->
    <FaqSection />
  </main>
  <Footer />
</Layout>
