---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="403 Forbidden · Access Restricted | Ratti to Carat"
  description="Access to this resource has been restricted. Return to rattitocarat.com to continue using the gemstone weight calculator."
  canonicalUrl="https://rattitocarat.com/403"
>
  <Navbar />

  <main class="relative min-h-[75vh] flex items-center justify-center px-4 sm:px-6 py-12 sm:py-16">
    <!-- Elevated Master Error Card -->
    <div class="max-w-lg w-full rounded-3xl atelier-card-elevated p-8 sm:p-10 border border-slate-200/90 shadow-lg text-center space-y-7 glow-gold-sm">
      
      <!-- Icon & Status Pill -->
      <div class="flex flex-col items-center gap-3">
        <div class="w-16 h-16 rounded-2xl bg-amber-500/10 border border-amber-300/60 flex items-center justify-center text-amber-700 shadow-inner">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-amber-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
        </div>
        <span class="px-3 py-1 rounded-full bg-slate-100 text-slate-700 text-xs font-mono font-semibold border border-slate-200 tracking-wide">
          HTTP 403 · Access Restricted
        </span>
      </div>

      <!-- Main Headline & Description -->
      <div class="space-y-2.5">
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 font-display">
          Access to This Page is Blocked
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed max-w-sm mx-auto">
          Your connection was blocked by security policies or firewall rules. This can happen if you are browsing through an unrecognized proxy, VPN, or rate limit.
        </p>
      </div>

      <!-- Substantial, High-Polish Action Buttons -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 pt-1">
        <a
          href="/"
          class="h-12 px-6 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-sm shadow-sm flex items-center justify-center gap-2.5 transition-all hover:scale-[1.02] active:scale-95"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
          <span>Return to Calculator</span>
        </a>

        <a
          href="/faqs"
          class="h-12 px-5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold text-sm border border-slate-200 flex items-center justify-center gap-2 transition-all hover:scale-[1.02] active:scale-95"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
            <line x1="12" y1="17" x2="12.01" y2="17"/>
          </svg>
          <span>Browse FAQs</span>
        </a>
      </div>

      <!-- Compact Formula Emergency Reference Box -->
      <div class="pt-5 border-t border-slate-100 text-left">
        <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-2">
          <div class="flex items-center justify-between text-xs font-bold text-slate-700">
            <span>⚡ Offline Formula Reference</span>
            <span class="text-[10px] font-mono text-emerald-800 bg-emerald-100/70 px-2 py-0.5 rounded-full font-semibold">100% Client-Safe</span>
          </div>
          <div class="grid grid-cols-2 gap-2 text-xs font-mono">
            <div class="p-2 rounded-xl bg-white border border-slate-200">
              <span class="text-slate-400 block text-[10px]">Carat → Ratti</span>
              <span class="font-bold text-slate-900">Weight ÷ 0.9100</span>
            </div>
            <div class="p-2 rounded-xl bg-white border border-slate-200">
              <span class="text-slate-400 block text-[10px]">Ratti → Carat</span>
              <span class="font-bold text-slate-900">Weight × 0.9100</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </main>

  <Footer />
</Layout>
