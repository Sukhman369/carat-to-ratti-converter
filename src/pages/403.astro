---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="403 Forbidden · Access Restricted | Ratti to Carat"
  description="Access to this resource has been restricted. Return to rattitocarat.com to continue using the gemstone weight calculator."
  canonicalUrl="https://rattitocarat.com/403"
>
  <Navbar />

  <main class="relative min-h-[70vh] flex items-center justify-center px-4 sm:px-6 py-12">
    <div class="max-w-xl w-full text-center space-y-8">
      
      <!-- Icon & Status Code -->
      <div class="space-y-3">
        <div class="relative inline-flex items-center justify-center">
          <!-- Ambient Glow -->
          <div class="absolute inset-0 rounded-full bg-amber-500/10 blur-2xl"></div>
          
          <div class="relative w-20 h-20 rounded-3xl bg-gradient-to-br from-amber-50 to-orange-100 border border-amber-200/80 shadow-md flex items-center justify-center text-amber-700">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
          </div>
        </div>

        <div class="inline-block px-3 py-1 rounded-full bg-slate-100 border border-slate-200 text-xs font-mono font-bold text-slate-700 uppercase tracking-widest">
          HTTP Error 403 · Access Forbidden
        </div>
      </div>

      <!-- Main Explanation -->
      <div class="space-y-3">
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 font-display">
          Access to This Resource is Restricted
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed max-w-md mx-auto">
          Your connection or request was blocked by security policies or firewall rules. This can occur if you are browsing via an unrecognized proxy, VPN, or automated rate limiter.
        </p>
      </div>

      <!-- Primary Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
        <a
          href="/"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-slate-900 hover:bg-slate-800 text-white font-semibold text-xs shadow-sm transition-all hover:scale-105 active:scale-95"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
          <span>Return to Master Calculator</span>
        </a>

        <a
          href="/faqs"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full bg-white hover:bg-slate-50 text-slate-700 font-semibold text-xs border border-slate-200 shadow-xs transition-all hover:scale-105 active:scale-95"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
            <line x1="12" y1="17" x2="12.01" y2="17"/>
          </svg>
          <span>Browse FAQs & Help</span>
        </a>
      </div>

      <!-- Emergency Offline Quick Reference Card -->
      <div class="pt-6 border-t border-slate-200/80">
        <div class="p-4 rounded-2xl bg-white border border-slate-200 shadow-xs space-y-2 text-left">
          <div class="flex items-center justify-between text-xs font-bold text-slate-800">
            <span>⚡ Essential Emergency Reference</span>
            <span class="text-[10px] font-mono text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200 font-semibold">Offline Safe</span>
          </div>
          <div class="grid grid-cols-2 gap-2 text-[11px] font-mono text-slate-600 pt-1">
            <div class="p-2 rounded-lg bg-slate-50 border border-slate-100">
              <span class="text-slate-400 block text-[10px]">Carat → Ratti</span>
              <span class="font-bold text-slate-900">Weight ÷ 0.9100</span>
            </div>
            <div class="p-2 rounded-lg bg-slate-50 border border-slate-100">
              <span class="text-slate-400 block text-[10px]">Ratti → Carat</span>
              <span class="font-bold text-slate-900">Weight × 0.9100</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </main>

  <Footer />
</Layout>
