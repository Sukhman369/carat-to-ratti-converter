---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import HeroCalculator from '../components/HeroCalculator.astro';
import BodyWeightCalc from '../components/BodyWeightCalc.astro';
import GemstoneGrid from '../components/GemstoneGrid.astro';
import ConversionTables from '../components/ConversionTables.astro';
import ExplainerSection from '../components/ExplainerSection.astro';
import FaqSection from '../components/FaqSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Ratti to Carat Converter | Exact Vedic & Lab Gemstone Calculator (0.91 Ratio)"
  description="Convert Ratti to Carats (Ct), Milligrams (mg), and Grains with certified 0.91 Pakka Ratti ratio and 0.90 Sunee trade standard. Features astrological Sawa detector and Vedic body-weight dosage calculator."
  canonicalUrl="https://rattitocarat.com"
>
  <Navbar />
  <main class="relative space-y-4">
    <!-- Master Hero Interactive Calculator -->
    <HeroCalculator />

    <!-- Vedic Body Weight Dosage Tool Section -->
    <BodyWeightCalc />

    <!-- Navratna Astrological Presets Grid -->
    <GemstoneGrid />

    <!-- Featured Snippet Conversion Tables -->
    <ConversionTables />

    <!-- Educational & Gemological Explainer -->
    <ExplainerSection />

    <!-- Accessible FAQ Accordion -->
    <FaqSection />
  </main>
  <Footer />
</Layout>
