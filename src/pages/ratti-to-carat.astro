---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import HeroCalculator from '../components/HeroCalculator.astro';
import ConversionTables from '../components/ConversionTables.astro';
import ExplainerSection from '../components/ExplainerSection.astro';
import FaqSection from '../components/FaqSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Ratti to Carat Converter | Exact Vedic Gemstone Calculator (0.91 Ratio)"
  description="Convert Ratti to Carats (Ct) instantly with certified 0.91 Pakka Ratti ratio and 0.90 Sunee trade ratio. Includes 1 to 15 Ratti conversion tables and Sawa astrological breakdowns."
  canonicalUrl="https://rattitocarat.com/ratti-to-carat"
>
  <Navbar />
  <main class="relative space-y-8 py-4">
    <!-- Breadcrumbs -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 pt-4">
      <nav class="flex items-center gap-2 text-xs text-zinc-500 font-mono">
        <a href="/" class="hover:text-amber-400 transition-colors">Home</a>
        <span>/</span>
        <span class="text-zinc-300">Ratti to Carat</span>
      </nav>
    </div>

    <!-- Hero Calculator (Ratti Intent) -->
    <HeroCalculator />

    <!-- Static Quick Formula Banner -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="p-6 rounded-2xl atelier-card border border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h2 class="text-base font-bold text-white font-display">Ratti to Carat Conversion Formula</h2>
          <p class="text-xs text-zinc-400 mt-1">
            To convert Ratti to Carats, multiply the Ratti value by <strong>0.91</strong> (for Pakka Ratti) or by <strong>0.90</strong> (for Sunee Ratti).
          </p>
        </div>
        <div class="px-4 py-2 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-300 font-mono font-bold text-sm shrink-0">
          Carats = Ratti × 0.91
        </div>
      </div>
    </div>

    <!-- Conversion Tables -->
    <ConversionTables />

    <!-- Educational Explainer -->
    <ExplainerSection />

    <!-- FAQ -->
    <FaqSection />
  </main>
  <Footer />
</Layout>
