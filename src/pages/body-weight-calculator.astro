---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import BodyWeightCalc from '../components/BodyWeightCalc.astro';
import GemstoneGrid from '../components/GemstoneGrid.astro';
import FaqSection from '../components/FaqSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Vedic Gemstone Weight by Body Weight Calculator | Ratti Dosage Guide"
  description="Calculate your astrologically recommended gemstone weight in Ratti and Carats based on your body weight (1 Ratti per 10–12 kg rule). Free Vedic dosage tool."
  canonicalUrl="https://rattitocarat.com/body-weight-calculator"
>
  <Navbar />
  <main class="relative space-y-8 py-4">
    <!-- Breadcrumbs -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 pt-4">
      <nav class="flex items-center gap-2 text-xs text-zinc-500 font-mono">
        <a href="/" class="hover:text-amber-400 transition-colors">Home</a>
        <span>/</span>
        <span class="text-zinc-300">Body Weight Calculator</span>
      </nav>
    </div>

    <!-- Body Weight Tool -->
    <BodyWeightCalc />

    <!-- Deep Astrological Dosage Explainer -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="p-6 sm:p-8 rounded-3xl atelier-card border border-white/10 space-y-6">
        <h2 class="text-xl sm:text-2xl font-bold text-white font-display">
          How Vedic Astrologers Determine Gemstone Dosage
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs sm:text-sm text-zinc-400 leading-relaxed">
          <div class="space-y-3">
            <h3 class="font-bold text-amber-300 text-sm">1. The Body Mass Ratio Principle</h3>
            <p>
              In traditional Vedic astrology (Jyotish Shastra), the human body acts as an energetic conduit absorbing cosmic planetary rays through gemstones. Just as medicinal dosage scales with body mass, astrological gem weight is calibrated at <strong>1 Ratti per 10 to 12 kilograms of body weight</strong>.
            </p>
          </div>
          <div class="space-y-3">
            <h3 class="font-bold text-amber-300 text-sm">2. Why Minimum Weight Matters</h3>
            <p>
              Wearing a gemstone below your body’s baseline threshold (e.g., wearing a 2 Ratti Yellow Sapphire when weighing 75 kg) produces negligible remedial aura. The minimum weight ensures the stone's vibrational resonance penetrates the wearer's bio-field.
            </p>
          </div>
        </div>

        <!-- Body Weight Reference Table -->
        <div class="pt-4 border-t border-white/10">
          <h3 class="text-xs font-semibold text-zinc-300 uppercase tracking-wider mb-3">
            Quick Body Weight to Ratti Dosage Chart
          </h3>
          <div class="overflow-x-auto rounded-xl border border-white/10">
            <table class="w-full text-left text-xs font-mono">
              <thead class="bg-black/50 text-zinc-400 border-b border-white/10">
                <tr>
                  <th class="p-3">Body Weight</th>
                  <th class="p-3 text-amber-400">Recommended Ratti</th>
                  <th class="p-3">Equivalent Carats (0.91)</th>
                  <th class="p-3 font-sans">Auspicious Target</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/5 text-zinc-300">
                <tr class="hover:bg-white/5">
                  <td class="p-3">45 – 55 kg</td>
                  <td class="p-3 font-bold text-amber-300">4.25 – 5.00 Ratti</td>
                  <td class="p-3">3.87 – 4.55 Ct</td>
                  <td class="p-3 font-sans text-amber-400 font-medium">Sawa Chaar (4.25 Rt)</td>
                </tr>
                <tr class="hover:bg-white/5">
                  <td class="p-3">55 – 65 kg</td>
                  <td class="p-3 font-bold text-amber-300">5.25 – 6.00 Ratti</td>
                  <td class="p-3">4.78 – 5.46 Ct</td>
                  <td class="p-3 font-sans text-amber-400 font-medium">Sawa Paanch (5.25 Rt)</td>
                </tr>
                <tr class="hover:bg-white/5">
                  <td class="p-3">65 – 75 kg</td>
                  <td class="p-3 font-bold text-amber-300">6.25 – 7.00 Ratti</td>
                  <td class="p-3">5.69 – 6.37 Ct</td>
                  <td class="p-3 font-sans text-amber-400 font-medium">Sawa Chhah (6.25 Rt)</td>
                </tr>
                <tr class="hover:bg-white/5">
                  <td class="p-3">75 – 85 kg</td>
                  <td class="p-3 font-bold text-amber-300">7.25 – 8.00 Ratti</td>
                  <td class="p-3">6.60 – 7.28 Ct</td>
                  <td class="p-3 font-sans text-amber-400 font-medium">Sawa Saat (7.25 Rt)</td>
                </tr>
                <tr class="hover:bg-white/5">
                  <td class="p-3">85+ kg</td>
                  <td class="p-3 font-bold text-amber-300">8.25 – 10.25 Ratti</td>
                  <td class="p-3">7.51 – 9.33 Ct</td>
                  <td class="p-3 font-sans text-amber-400 font-medium">Sawa Aath / Sawa Nau</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Navratna Presets -->
    <GemstoneGrid />

    <!-- FAQ -->
    <FaqSection />
  </main>
  <Footer />
</Layout>
