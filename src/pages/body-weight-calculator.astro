---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import BodyWeightCalc from '../components/BodyWeightCalc.astro';
import GemstoneGrid from '../components/GemstoneGrid.astro';
import FaqSection from '../components/FaqSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Vedic Gemstone Weight by Body Weight Calculator | Ratti Dosage Guide"
  description="Calculate your astrologically recommended gemstone weight in Ratti and Carats based on your body weight (1 Ratti per 10–12 kg rule). Free Vedic dosage tool."
  canonicalUrl="https://rattitocarat.com/body-weight-calculator"
>
  <Navbar />
  <main class="relative space-y-8 py-4">
    <!-- Breadcrumbs -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 pt-4">
      <nav class="flex items-center gap-2 text-xs text-slate-500 font-mono">
        <a href="/" class="hover:text-amber-700 transition-colors">Home</a>
        <span>/</span>
        <span class="text-slate-800 font-semibold">Body Weight Calculator</span>
      </nav>
    </div>

    <!-- Body Weight Tool -->
    <BodyWeightCalc />

    <!-- Deep Astrological Dosage Explainer -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="p-6 sm:p-8 rounded-3xl atelier-card border border-slate-200 space-y-6 shadow-sm">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 font-display">
          How Vedic Astrologers Determine Gemstone Dosage
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs sm:text-sm text-slate-600 leading-relaxed">
          <div class="space-y-3">
            <h3 class="font-bold text-slate-900 text-sm flex items-center gap-2">
              <span>⚖️</span> 1. The Body Mass Ratio Principle
            </h3>
            <p>
              In traditional Vedic astrology (Jyotish Shastra), the human body acts as an energetic conduit absorbing cosmic planetary rays through gemstones. Just as medicinal dosage scales with body mass, astrological gem weight is calibrated at <strong>1 Ratti per 10 to 12 kilograms of body weight</strong>.
            </p>
          </div>
          <div class="space-y-3">
            <h3 class="font-bold text-slate-900 text-sm flex items-center gap-2">
              <span>🎯</span> 2. Why Minimum Weight Matters
            </h3>
            <p>
              Wearing a gemstone below your body’s baseline threshold (e.g., wearing a 2 Ratti Yellow Sapphire when weighing 75 kg) produces negligible remedial aura. The minimum weight ensures the stone's vibrational resonance penetrates the wearer's bio-field.
            </p>
          </div>
        </div>

        <!-- Body Weight Reference Table -->
        <div class="pt-4 border-t border-slate-100">
          <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-3">
            Quick Body Weight to Ratti Dosage Chart
          </h3>
          <div class="overflow-x-auto rounded-2xl border border-slate-200">
            <table class="w-full text-left text-xs font-mono">
              <thead class="bg-slate-50 text-slate-500 border-b border-slate-200 uppercase text-[11px] tracking-wider">
                <tr>
                  <th class="p-3.5 text-slate-900">Body Weight</th>
                  <th class="p-3.5 text-amber-800">Recommended Ratti</th>
                  <th class="p-3.5">Equivalent Carats (0.91)</th>
                  <th class="p-3.5 font-sans">Auspicious Target</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 text-slate-700 bg-white">
                <tr class="hover:bg-amber-50/40 transition-colors">
                  <td class="p-3.5 font-bold text-slate-900">45 – 55 kg</td>
                  <td class="p-3.5 font-bold text-amber-800">4.25 – 5.00 Ratti</td>
                  <td class="p-3.5 text-slate-500">3.87 – 4.55 Ct</td>
                  <td class="p-3.5 font-sans text-amber-900 font-bold">Sawa Chaar (4.25 Rt)</td>
                </tr>
                <tr class="hover:bg-amber-50/40 transition-colors">
                  <td class="p-3.5 font-bold text-slate-900">55 – 65 kg</td>
                  <td class="p-3.5 font-bold text-amber-800">5.25 – 6.00 Ratti</td>
                  <td class="p-3.5 text-slate-500">4.78 – 5.46 Ct</td>
                  <td class="p-3.5 font-sans text-amber-900 font-bold">Sawa Paanch (5.25 Rt)</td>
                </tr>
                <tr class="hover:bg-amber-50/40 transition-colors">
                  <td class="p-3.5 font-bold text-slate-900">65 – 75 kg</td>
                  <td class="p-3.5 font-bold text-amber-800">6.25 – 7.00 Ratti</td>
                  <td class="p-3.5 text-slate-500">5.69 – 6.37 Ct</td>
                  <td class="p-3.5 font-sans text-amber-900 font-bold">Sawa Chhah (6.25 Rt)</td>
                </tr>
                <tr class="hover:bg-amber-50/40 transition-colors">
                  <td class="p-3.5 font-bold text-slate-900">75 – 85 kg</td>
                  <td class="p-3.5 font-bold text-amber-800">7.25 – 8.00 Ratti</td>
                  <td class="p-3.5 text-slate-500">6.60 – 7.28 Ct</td>
                  <td class="p-3.5 font-sans text-amber-900 font-bold">Sawa Saat (7.25 Rt)</td>
                </tr>
                <tr class="hover:bg-amber-50/40 transition-colors">
                  <td class="p-3.5 font-bold text-slate-900">85+ kg</td>
                  <td class="p-3.5 font-bold text-amber-800">8.25 – 10.25 Ratti</td>
                  <td class="p-3.5 text-slate-500">7.51 – 9.33 Ct</td>
                  <td class="p-3.5 font-sans text-amber-900 font-bold">Sawa Aath / Sawa Nau</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Navratna Presets -->
    <GemstoneGrid />

    <!-- FAQ -->
    <FaqSection />
  </main>
  <Footer />
</Layout>
