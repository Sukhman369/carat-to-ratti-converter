---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="404 · The Cosmic Gemstone Vault | Ratti to Carat"
  description="You've discovered the celestial gemstone vault. Calibrate the cosmic balance scale, balance sacred Navratna & Upratna gems, or return to the live converter."
  canonicalUrl="https://rattitocarat.com/404"
>
  <Navbar />

  <main class="relative min-h-[80vh] flex flex-col items-center justify-center px-4 sm:px-6 py-6 sm:py-8 overflow-hidden">
    
    <!-- Ambient Celestial Glow Orbs -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-96 h-96 bg-gradient-to-tr from-amber-300/20 via-orange-300/10 to-amber-500/20 rounded-full blur-3xl pointer-events-none -z-10"></div>

    <div class="max-w-2xl w-full text-center space-y-4">
      
      <!-- Top Status Header (Compact) -->
      <div class="space-y-1.5">
        <div class="inline-flex items-center gap-2 px-3 py-0.5 rounded-full bg-amber-50 text-amber-800 text-[11px] font-mono font-bold uppercase tracking-widest border border-amber-200 shadow-xs">
          <span>✨ 404 · Celestial Gem Vault</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 font-display">
          Lost in the Cosmic Balance
        </h1>
        <p class="text-xs text-slate-600 max-w-md mx-auto leading-relaxed">
          Tap any of the 10 sacred gems in the 2-row grid below to drop weight and balance the cosmic scale!
        </p>
      </div>

      <!-- Smart URL Intent Detector (Appears if user mistyped a weight URL) -->
      <div id="url-intent-box" class="hidden p-3 rounded-2xl bg-amber-50/90 border border-amber-300/80 shadow-xs text-center space-y-1 animate-in fade-in zoom-in-95 duration-300">
        <div class="flex items-center justify-center gap-1.5 text-xs font-bold text-amber-900">
          <span>🔍</span>
          <span>We detected a weight in your link!</span>
        </div>
        <p class="text-xs text-slate-700" id="url-intent-text"></p>
        <a
          id="url-intent-link"
          href="/"
          class="inline-flex items-center gap-1.5 px-4 py-1 rounded-lg bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs shadow-xs transition-all"
        >
          <span>Calculate This Weight Now →</span>
        </a>
      </div>

      <!-- Interactive Celestial Balance Scale Card -->
      <div class="rounded-3xl atelier-card-elevated p-4 sm:p-6 border border-slate-200 shadow-xl space-y-3.5 glow-gold-sm text-center">
        
        <!-- Live Scale Readout Bar -->
        <div class="flex items-center justify-between gap-2 pb-2.5 border-b border-slate-100 text-xs">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
            <span class="text-xs font-semibold text-slate-500">Live Calibration</span>
          </div>
          <div class="font-mono font-bold text-amber-800 bg-amber-50 px-2.5 py-0.5 rounded-full border border-amber-200 text-[11px]">
            Mass: <span id="scale-total-ratti">0.00</span> Rt (<span id="scale-total-carats">0.00</span> Ct)
          </div>
        </div>

        <!-- The Mathematically Centered SVG Balance Scale -->
        <div class="w-full flex flex-col items-center justify-center select-none pt-1">
          <svg
            id="celestial-scale-svg"
            viewBox="0 0 400 135"
            class="w-full max-w-[340px] sm:max-w-[400px] h-auto overflow-visible mx-auto"
          >
            <defs>
              <linearGradient id="scale-gold-grad" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#f59e0b" />
                <stop offset="50%" stop-color="#d97706" />
                <stop offset="100%" stop-color="#b45309" />
              </linearGradient>
              <linearGradient id="pan-gold-grad" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#fef3c7" />
                <stop offset="100%" stop-color="#fde68a" />
              </linearGradient>
              <linearGradient id="pillar-grad" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#d97706" />
                <stop offset="60%" stop-color="#64748b" />
                <stop offset="100%" stop-color="#334155" />
              </linearGradient>
              <filter id="shadow" x="-10%" y="-10%" width="120%" height="130%">
                <feDropShadow dx="0" dy="2" stdDeviation="2" flood-opacity="0.15" />
              </filter>
            </defs>

            <!-- Base Stand (Exact Center at X=200) -->
            <rect x="140" y="118" width="120" height="10" rx="5" fill="#64748b" />
            <rect x="165" y="112" width="70" height="6" rx="3" fill="#cbd5e1" />
            
            <!-- Central Pillar (Centered at X=200) -->
            <rect x="196" y="25" width="8" height="93" rx="4" fill="url(#pillar-grad)" />

            <!-- Rotating Beam Assembly (Pivot Point at X=200, Y=25) -->
            <g id="scale-beam-group" style="transform-origin: 200px 25px; transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);">
              <!-- Main Horizontal Beam -->
              <rect x="50" y="22" width="300" height="6" rx="3" fill="url(#scale-gold-grad)" filter="url(#shadow)" />
              
              <!-- Left Pan Assembly (Suspended from X=70, Y=25) -->
              <g id="left-pan-group">
                <circle cx="70" cy="25" r="3.5" fill="#f59e0b" stroke="#78350f" stroke-width="1" />
                <line x1="70" y1="25" x2="45" y2="72" stroke="#94a3b8" stroke-width="1.5" />
                <line x1="70" y1="25" x2="95" y2="72" stroke="#94a3b8" stroke-width="1.5" />
                <!-- Left Tray -->
                <path d="M 40 72 Q 70 92 100 72 Z" fill="url(#pan-gold-grad)" stroke="#d97706" stroke-width="1.5" filter="url(#shadow)" />
                <text id="left-pan-count" x="70" y="67" text-anchor="middle" font-size="11" font-family="monospace" font-weight="bold" fill="#78350f">0.0 Rt</text>
              </g>

              <!-- Right Pan Assembly (Suspended from X=330, Y=25) -->
              <g id="right-pan-group">
                <circle cx="330" cy="25" r="3.5" fill="#f59e0b" stroke="#78350f" stroke-width="1" />
                <line x1="330" y1="25" x2="305" y2="72" stroke="#94a3b8" stroke-width="1.5" />
                <line x1="330" y1="25" x2="355" y2="72" stroke="#94a3b8" stroke-width="1.5" />
                <!-- Right Tray -->
                <path d="M 300 72 Q 330 92 360 72 Z" fill="url(#pan-gold-grad)" stroke="#d97706" stroke-width="1.5" filter="url(#shadow)" />
                <text id="right-pan-count" x="330" y="67" text-anchor="middle" font-size="11" font-family="monospace" font-weight="bold" fill="#78350f">0.0 Rt</text>
              </g>
            </g>

            <!-- Top Pivot Fixed Center Cap (Centered at X=200, Y=25) -->
            <circle cx="200" cy="25" r="7" fill="#d97706" stroke="#ffffff" stroke-width="2" filter="url(#shadow)" />
            <circle cx="200" cy="25" r="3" fill="#ffffff" />
          </svg>

          <!-- Active Oracle Message (Directly below scale with zero overlap) -->
          <p id="oracle-message" class="text-xs font-semibold text-slate-700 italic pt-2">
            "Tap any gemstone below to load the scale..."
          </p>
        </div>

        <!-- 10 Sacred Gemstones in 2 Symmetrical Rows of 5 -->
        <div class="space-y-1.5 pt-2 border-t border-slate-100">
          <div class="flex items-center justify-between px-1 text-[10px] font-bold uppercase tracking-wider text-slate-400">
            <span>✨ Tap Gemstones to Balance Scale</span>
          </div>

          <div class="grid grid-cols-5 gap-1.5 sm:gap-2 select-none" id="gems-grid">
            
            <!-- Row 1: 5 Primary Gems -->
            <button type="button" class="gem-btn p-1.5 sm:p-2 rounded-xl bg-slate-50 hover:bg-amber-100/70 border border-slate-200 hover:border-amber-400 transition-all hover:scale-105 active:scale-90 flex flex-col items-center justify-center gap-0.5 cursor-pointer shadow-2xs" data-gem="Manik (Ruby)" data-ratti="4.25" data-side="left" data-freq="528">
              <span class="text-base sm:text-lg">☀️</span>
              <span class="text-[10px] font-bold text-slate-900 leading-tight">Manik</span>
              <span class="text-[9px] font-mono text-slate-500 leading-tight">4.25 Rt</span>
            </button>

            <button type="button" class="gem-btn p-1.5 sm:p-2 rounded-xl bg-slate-50 hover:bg-amber-100/70 border border-slate-200 hover:border-amber-400 transition-all hover:scale-105 active:scale-90 flex flex-col items-center justify-center gap-0.5 cursor-pointer shadow-2xs" data-gem="Moti (Pearl)" data-ratti="5.25" data-side="left" data-freq="587">
              <span class="text-base sm:text-lg">🌕</span>
              <span class="text-[10px] font-bold text-slate-900 leading-tight">Moti</span>
              <span class="text-[9px] font-mono text-slate-500 leading-tight">5.25 Rt</span>
            </button>

            <button type="button" class="gem-btn p-1.5 sm:p-2 rounded-xl bg-slate-50 hover:bg-amber-100/70 border border-slate-200 hover:border-amber-400 transition-all hover:scale-105 active:scale-90 flex flex-col items-center justify-center gap-0.5 cursor-pointer shadow-2xs" data-gem="Pukhraj (Yellow Sapphire)" data-ratti="5.25" data-side="left" data-freq="659">
              <span class="text-base sm:text-lg">🌟</span>
              <span class="text-[10px] font-bold text-slate-900 leading-tight">Pukhraj</span>
              <span class="text-[9px] font-mono text-slate-500 leading-tight">5.25 Rt</span>
            </button>

            <button type="button" class="gem-btn p-1.5 sm:p-2 rounded-xl bg-slate-50 hover:bg-amber-100/70 border border-slate-200 hover:border-amber-400 transition-all hover:scale-105 active:scale-90 flex flex-col items-center justify-center gap-0.5 cursor-pointer shadow-2xs" data-gem="Panna (Emerald)" data-ratti="3.25" data-side="left" data-freq="698">
              <span class="text-base sm:text-lg">🌿</span>
              <span class="text-[10px] font-bold text-slate-900 leading-tight">Panna</span>
              <span class="text-[9px] font-mono text-slate-500 leading-tight">3.25 Rt</span>
            </button>

            <button type="button" class="gem-btn p-1.5 sm:p-2 rounded-xl bg-slate-50 hover:bg-amber-100/70 border border-slate-200 hover:border-amber-400 transition-all hover:scale-105 active:scale-90 flex flex-col items-center justify-center gap-0.5 cursor-pointer shadow-2xs" data-gem="Heera (Diamond)" data-ratti="1.25" data-side="right" data-freq="784">
              <span class="text-base sm:text-lg">💎</span>
              <span class="text-[10px] font-bold text-slate-900 leading-tight">Heera</span>
              <span class="text-[9px] font-mono text-slate-500 leading-tight">1.25 Rt</span>
            </button>

            <!-- Row 2: 5 Cosmic & Planetary Gems -->
            <button type="button" class="gem-btn p-1.5 sm:p-2 rounded-xl bg-slate-50 hover:bg-amber-100/70 border border-slate-200 hover:border-amber-400 transition-all hover:scale-105 active:scale-90 flex flex-col items-center justify-center gap-0.5 cursor-pointer shadow-2xs" data-gem="Neelam (Blue Sapphire)" data-ratti="4.25" data-side="right" data-freq="880">
              <span class="text-base sm:text-lg">🪐</span>
              <span class="text-[10px] font-bold text-slate-900 leading-tight">Neelam</span>
              <span class="text-[9px] font-mono text-slate-500 leading-tight">4.25 Rt</span>
            </button>

            <button type="button" class="gem-btn p-1.5 sm:p-2 rounded-xl bg-slate-50 hover:bg-amber-100/70 border border-slate-200 hover:border-amber-400 transition-all hover:scale-105 active:scale-90 flex flex-col items-center justify-center gap-0.5 cursor-pointer shadow-2xs" data-gem="Moonga (Red Coral)" data-ratti="6.25" data-side="left" data-freq="987">
              <span class="text-base sm:text-lg">🔥</span>
              <span class="text-[10px] font-bold text-slate-900 leading-tight">Moonga</span>
              <span class="text-[9px] font-mono text-slate-500 leading-tight">6.25 Rt</span>
            </button>

            <button type="button" class="gem-btn p-1.5 sm:p-2 rounded-xl bg-slate-50 hover:bg-amber-100/70 border border-slate-200 hover:border-amber-400 transition-all hover:scale-105 active:scale-90 flex flex-col items-center justify-center gap-0.5 cursor-pointer shadow-2xs" data-gem="Gomed (Hessonite)" data-ratti="7.25" data-side="right" data-freq="1046">
              <span class="text-base sm:text-lg">🌪️</span>
              <span class="text-[10px] font-bold text-slate-900 leading-tight">Gomed</span>
              <span class="text-[9px] font-mono text-slate-500 leading-tight">7.25 Rt</span>
            </button>

            <button type="button" class="gem-btn p-1.5 sm:p-2 rounded-xl bg-slate-50 hover:bg-amber-100/70 border border-slate-200 hover:border-amber-400 transition-all hover:scale-105 active:scale-90 flex flex-col items-center justify-center gap-0.5 cursor-pointer shadow-2xs" data-gem="Lehsuniya (Cat's Eye)" data-ratti="5.25" data-side="right" data-freq="1174">
              <span class="text-base sm:text-lg">👁️</span>
              <span class="text-[10px] font-bold text-slate-900 leading-tight">Lehsuniya</span>
              <span class="text-[9px] font-mono text-slate-500 leading-tight">5.25 Rt</span>
            </button>

            <button type="button" class="gem-btn p-1.5 sm:p-2 rounded-xl bg-slate-50 hover:bg-amber-100/70 border border-slate-200 hover:border-amber-400 transition-all hover:scale-105 active:scale-90 flex flex-col items-center justify-center gap-0.5 cursor-pointer shadow-2xs" data-gem="Jamunia (Amethyst)" data-ratti="6.25" data-side="right" data-freq="1318">
              <span class="text-base sm:text-lg">🔮</span>
              <span class="text-[10px] font-bold text-slate-900 leading-tight">Jamunia</span>
              <span class="text-[9px] font-mono text-slate-500 leading-tight">6.25 Rt</span>
            </button>

          </div>
        </div>

        <!-- Scale Controls & Reset -->
        <div class="flex items-center justify-between text-xs pt-1 px-1">
          <button
            type="button"
            id="btn-reset-scale"
            class="text-[11px] font-semibold text-slate-500 hover:text-slate-900 underline transition-colors cursor-pointer"
          >
            Reset Scale
          </button>
          <button
            type="button"
            id="btn-share-cosmic"
            class="text-[11px] font-semibold text-amber-700 hover:text-amber-800 flex items-center gap-1 transition-colors cursor-pointer"
          >
            <span>✨ Share Cosmic Score</span>
          </button>
        </div>

      </div>

      <!-- Teleport Back Primary Action Button (Above the Fold) -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-2.5 pt-1">
        <a
          href="/"
          class="w-full sm:w-auto h-11 px-7 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs shadow-md flex items-center justify-center gap-2 transition-all hover:scale-105 active:scale-95"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
          <span>Teleport to Master Calculator</span>
        </a>

        <a
          href="/body-weight-calculator"
          class="w-full sm:w-auto h-11 px-5 rounded-xl bg-white hover:bg-slate-50 text-slate-800 font-semibold text-xs border border-slate-200 shadow-xs flex items-center justify-center gap-2 transition-all hover:scale-105 active:scale-95"
        >
          <span>Body Weight Dosage</span>
        </a>
      </div>

    </div>
  </main>

  <Footer />
</Layout>

<!-- Web Audio Chimes & Balance Physics Engine -->
<script>
  let audioCtx: AudioContext | null = null;

  function playChime(freq: number) {
    try {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
      }
      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
      gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.5);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start();
      osc.stop(audioCtx.currentTime + 0.5);
    } catch (e) {
      // Audio not permitted or supported
    }
  }

  let leftWeight = 0;
  let rightWeight = 0;
  let leftCount = 0;
  let rightCount = 0;

  const beamGroup = document.getElementById('scale-beam-group');
  const totalRattiEl = document.getElementById('scale-total-ratti');
  const totalCaratsEl = document.getElementById('scale-total-carats');
  const leftCountEl = document.getElementById('left-pan-count');
  const rightCountEl = document.getElementById('right-pan-count');
  const oracleMsg = document.getElementById('oracle-message');
  const btnReset = document.getElementById('btn-reset-scale');
  const btnShare = document.getElementById('btn-share-cosmic');
  const gemButtons = document.querySelectorAll<HTMLButtonElement>('.gem-btn');

  const FORTUNES = [
    "Jupiter radiates benevolence! Sawa weight harmony achieved ✨",
    "Saturn demands disciplined focus. The cosmic balance shifts 🪐",
    "Venus adds luminous brilliance to your destiny 💎",
    "The Sun bolsters vitality and authority! ☀️",
    "Mercury sharpens your intellect with emerald precision 🌿",
    "Amethyst (Jamunia) brings profound clarity and peace 🔮"
  ];

  function updateScale() {
    const totalRatti = leftWeight + rightWeight;
    const totalCarats = totalRatti * 0.91;

    if (totalRattiEl) totalRattiEl.innerText = totalRatti.toFixed(2);
    if (totalCaratsEl) totalCaratsEl.innerText = totalCarats.toFixed(2);
    if (leftCountEl) leftCountEl.textContent = `${leftWeight.toFixed(1)} Rt`;
    if (rightCountEl) rightCountEl.textContent = `${rightWeight.toFixed(1)} Rt`;

    // Calculate rotation angle around exact SVG pivot (X=200, Y=25) (max ±12 deg)
    const diff = rightWeight - leftWeight;
    const angle = Math.max(-12, Math.min(12, diff * 2.2));

    if (beamGroup) {
      beamGroup.style.transform = `rotate(${angle}deg)`;
    }

    if (oracleMsg) {
      if (Math.abs(diff) < 0.1 && totalRatti > 0) {
        oracleMsg.innerText = "✨ Perfect Cosmic Equilibrium Achieved! Astrological forces aligned.";
      } else {
        const randFortune = FORTUNES[Math.floor(Math.random() * FORTUNES.length)];
        oracleMsg.innerText = randFortune;
      }
    }
  }

  gemButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const ratti = parseFloat(btn.getAttribute('data-ratti') || '1');
      const side = btn.getAttribute('data-side') || 'left';
      const freq = parseFloat(btn.getAttribute('data-freq') || '528');

      playChime(freq);

      if (side === 'left') {
        leftWeight += ratti;
        leftCount++;
      } else {
        rightWeight += ratti;
        rightCount++;
      }

      updateScale();
    });
  });

  btnReset?.addEventListener('click', () => {
    leftWeight = 0;
    rightWeight = 0;
    leftCount = 0;
    rightCount = 0;
    updateScale();
    if (oracleMsg) oracleMsg.innerText = "Scale recalibrated. Tap any gemstone to begin.";
  });

  btnShare?.addEventListener('click', () => {
    const totalRatti = (leftWeight + rightWeight).toFixed(2);
    const text = `I got lost in the 404 Vault on rattitocarat.com and balanced ${totalRatti} Ratti of celestial Navratna gems! ✨ Check it out: https://rattitocarat.com/404`;
    if (navigator.clipboard) {
      navigator.clipboard.writeText(text).then(() => {
        alert('Copied your Cosmic Score to clipboard! Share it with friends ✨');
      });
    }
  });

  // Intelligent URL Intent Detection
  const path = window.location.pathname;
  const numMatch = path.match(/\b\d+(\.\d+)?\b/);
  if (numMatch) {
    const num = parseFloat(numMatch[0]);
    if (!isNaN(num) && num > 0 && num <= 100) {
      const intentBox = document.getElementById('url-intent-box');
      const intentText = document.getElementById('url-intent-text');
      const intentLink = document.getElementById('url-intent-link') as HTMLAnchorElement;

      if (intentBox && intentText && intentLink) {
        intentText.innerText = `You entered "${path}". Did you want to convert ${num} Ratti (${(num * 0.91).toFixed(2)} Carats)?`;
        intentLink.href = `/?weight=${num}`;
        intentBox.classList.remove('hidden');
      }
    }
  }
</script>
