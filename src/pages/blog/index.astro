---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Gemological & Astrological Blog | Guides on Ratti, Carats & Vedic Gemstones"
  description="Expert articles and guides on gemstone weight conversions, Vedic astrology dosage calculations, Pakka vs Sunee standards, and jewelry trade insights."
  canonicalUrl="https://rattitocarat.com/blog"
>
  <Navbar />
  <main class="relative max-w-5xl mx-auto px-4 sm:px-6 py-10 space-y-10">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 font-mono">
      <a href="/" class="hover:text-amber-700 transition-colors">Home</a>
      <span>/</span>
      <span class="text-slate-800 font-semibold">Blog</span>
    </nav>

    <!-- Header Banner -->
    <section class="text-center space-y-3 max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-50 text-amber-800 text-xs font-semibold uppercase tracking-wider border border-amber-200 shadow-xs">
        <span>📖 Knowledge Base</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 font-display">
        Gemological Guides & Astrological Insights
      </h1>
      <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
        Deep-dive articles on gemstone weight conversions, classical Jyotish dosage rules, and certified jewelry market standards.
      </p>
    </section>

    <!-- Clean Empty / Ready State Container -->
    <section class="p-10 sm:p-14 rounded-3xl atelier-card border border-slate-200 text-center space-y-4 shadow-sm max-w-2xl mx-auto">
      <div class="w-14 h-14 rounded-2xl bg-amber-50 border border-amber-200 text-amber-700 flex items-center justify-center text-2xl mx-auto shadow-xs">
        ✍️
      </div>
      <h2 class="text-xl font-bold text-slate-900 font-display">
        Articles & Guides Coming Soon
      </h2>
      <p class="text-xs sm:text-sm text-slate-600 leading-relaxed max-w-md mx-auto">
        We are preparing comprehensive, research-backed guides written in collaboration with certified gemological laboratories and Vedic astrologers.
      </p>
      <div class="pt-4 flex justify-center">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold shadow-xs transition-all hover:scale-105 active:scale-95"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 18-6-6 6-6"/>
          </svg>
          <span>Back to Master Calculator</span>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
