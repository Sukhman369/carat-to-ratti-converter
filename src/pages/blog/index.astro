---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const ARTICLES = [
  {
    title: 'Pakka (0.91) vs Sunee (0.90) Ratti: The Definitive Guide to Avoid Overpaying',
    slug: '/blog/pakka-vs-sunee-ratti',
    category: 'Gemstone Standards',
    date: 'Jan 15, 2025',
    readTime: '6 min read',
    excerpt: 'Understand why a tiny difference of 0.01 between 182 mg and 180 mg causes major financial losses when buying Vedic gemstones like Pukhraj and Neelam.',
    icon: '⚖️'
  },
  {
    title: 'Vedic Sawa Ratti Guide: Why 5.25, 6.25, and 7.25 Ratti are Auspicious',
    slug: '/blog/sawa-ratti-astrological-rules',
    category: 'Vedic Jyotish',
    date: 'Jan 20, 2025',
    readTime: '7 min read',
    excerpt: 'Explore the Sanskrit roots of Sapada (+0.25) growth fractions, why Paune (-0.25) weights are strictly forbidden, and how to calibrate weight to your body mass.',
    icon: '🧘'
  }
];
---

<Layout
  title="Gemological & Astrological Blog | Guides on Ratti, Carats & Vedic Gemstones"
  description="Expert articles and guides on gemstone weight conversions, Vedic astrology dosage calculations, Pakka vs Sunee standards, and jewelry trade insights."
  canonicalUrl="https://rattitocarat.com/blog"
>
  <Navbar />

  <main class="relative max-w-5xl mx-auto px-4 sm:px-6 py-10 space-y-10">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 font-mono">
      <a href="/" class="hover:text-amber-700 transition-colors">Home</a>
      <span>/</span>
      <span class="text-slate-800 font-semibold">Blog</span>
    </nav>

    <!-- Header Banner -->
    <section class="text-center space-y-3 max-w-2xl mx-auto">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 font-display">
        Gemological Guides & Astrological Insights
      </h1>
      <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
        Deep-dive research articles on gemstone weight conversions, classical Jyotish dosage rules, and certified jewelry market standards.
      </p>
    </section>

    <!-- 2-Column Articles Grid -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {ARTICLES.map((article) => (
        <a
          href={article.slug}
          class="group p-6 sm:p-8 rounded-3xl atelier-card border border-slate-200 hover:border-amber-400/80 transition-all hover:shadow-md hover:-translate-y-1 flex flex-col justify-between space-y-5"
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between text-xs">
              <span class="px-3 py-1 rounded-full bg-amber-50 text-amber-800 font-bold uppercase tracking-wider border border-amber-200">
                {article.category}
              </span>
              <span class="text-slate-500 font-mono text-[11px]">{article.readTime}</span>
            </div>

            <h2 class="text-xl sm:text-2xl font-bold font-display text-slate-900 group-hover:text-amber-700 transition-colors leading-snug">
              {article.title}
            </h2>

            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              {article.excerpt}
            </p>
          </div>

          <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-slate-500">
            <span class="font-mono text-[11px]">{article.date}</span>
            <span class="text-amber-700 group-hover:translate-x-1 transition-transform flex items-center gap-1 font-bold">
              <span>Read Full Guide</span>
              <span>→</span>
            </span>
          </div>
        </a>
      ))}
    </section>
  </main>

  <Footer />
</Layout>
